# ---------------------------------------------------------------------------
# Wellsure HR Portal — example environment variables
# Copy to .env and fill in. In apps/api this is loaded and validated with Zod
# at boot (fail fast on missing/invalid config) — see apps/api/src/config.
# In AWS these are injected via Secrets Manager / ECS task env instead of a
# .env file — see docs/PROJECT_SPEC.md §15.3.
# ---------------------------------------------------------------------------

# App
APP_ENV=development            # development | staging | production
PORT=4000
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
TZ_BUSINESS=Asia/Kolkata

# Postgres (docker-compose)
DATABASE_URL=postgresql://wellsure:wellsure@localhost:5432/wellsure_hr

# Redis (docker-compose)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Field encryption (KMS envelope encryption in AWS; static dev key locally)
KMS_FIELD_KEY_ID=dev-local-key

# Storage — MinIO locally, S3 in AWS (see apps/api/src/integrations/storage)
STORAGE_DRIVER=minio            # minio | s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wellsure-documents-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=ap-south-1

# Mail — Mailpit locally, SES in AWS (see apps/api/src/integrations/mail)
MAIL_DRIVER=mailpit              # mailpit | ses
MAIL_HOST=localhost
MAIL_PORT=1025
SES_FROM=no-reply@example.com

# Biometric agent (apps/biometric-agent -> apps/api)
AGENT_API_KEYS=dev-local-agent-key

# AWS (staging/production only — unused locally)
AWS_REGION=ap-south-1
