# ---------------------------------------------------------------------------
# Wellsure HR Portal — example environment variables
# Copy to .env and fill in. In backend/ this is loaded and validated with Zod
# at boot (fail fast on missing/invalid config) — see backend/src/config.
# In AWS these are injected via Secrets Manager / ECS task env instead of a
# .env file — see docs/PROJECT_SPEC.md §15.3.
# ---------------------------------------------------------------------------

# App
APP_ENV=development            # development | staging | production
PORT=4000
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
TZ_BUSINESS=Asia/Kolkata

# Postgres — installed locally (see README.md "Local setup")
DATABASE_URL=postgresql://wellsure:wellsure@localhost:5432/wellsure_hr

# Redis — installed locally (see README.md "Local setup")
REDIS_URL=redis://localhost:6379

# PDF rendering (letters; payslips in Phase 6). Optional: Chrome/Chromium is
# auto-detected in the usual install locations. Set this if it isn't found.
# CHROMIUM_PATH=/usr/bin/chromium

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Field encryption (KMS envelope encryption in AWS; static dev key locally)
# and blind-index hashing for exact-match dedup/search on encrypted fields
# (bank account/PAN/Aadhaar) — see backend/src/lib/encryption.ts and
# fieldHash.ts. These must be two different secrets.
KMS_FIELD_KEY_ID=dev-local-key
FIELD_HASH_PEPPER=dev-local-pepper

# Storage — local filesystem in dev (STORAGE_LOCAL_DIR, default .storage/,
# gitignored; signed URLs simulated by the /dev/storage route), S3 in AWS
# (see backend/src/integrations/storage). S3_BUCKET is only required when
# STORAGE_DRIVER=s3.
STORAGE_DRIVER=local             # local | s3
STORAGE_LOCAL_DIR=.storage
STORAGE_SIGNED_URL_SECRET=dev-local-signing-secret
S3_BUCKET=

# Mail — console + .eml files in dev (MAIL_DEV_DIR, default .mail/,
# gitignored), SES in AWS (see backend/src/integrations/mail). SES_FROM is
# only required when MAIL_DRIVER=ses.
MAIL_DRIVER=console               # console | ses
MAIL_DEV_DIR=.mail
SES_FROM=no-reply@example.com

# Biometric agent (biometric-agent/ -> backend/)
AGENT_API_KEYS=dev-local-agent-key
# ADMS push is authenticated by the device serial alone. Unset = on everywhere except production; in production leave it
# unset (off) until /iclock is restricted to the office's address (docs/DEPLOYMENT.md, Phase 1.5 go-live checklist), then "true".
# ADMS_PUSH_ENABLED=true

# Backend entrypoint mode — api | worker | scheduler | migrate (see backend/src/index.ts)
APP_MODE=api

# CORS — allowed origin(s) for the browser app, comma-separated
CORS_ORIGIN=http://localhost:5173

# AWS (staging/production only — unused locally)
AWS_REGION=ap-south-1
