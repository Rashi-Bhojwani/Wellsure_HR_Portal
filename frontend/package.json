{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Wellsure HR Portal frontend — the Employee (ESS) portal and the HR/Admin portal, one React app.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:popovers": "node e2e/popovers.mjs",
    "check:sensitive-ui": "node e2e/sensitive-ui.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "dev": "vite",
    "lint": "eslint . && node scripts/check-design-tokens.mjs",
    "screenshots": "node e2e/screenshots.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.4.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
