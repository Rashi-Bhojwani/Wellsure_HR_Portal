{
  "name": "biometric-agent",
  "version": "0.2.0",
  "private": true,
  "description": "LAN sync agent: reads the on-prem ZKTeco/eSSL biometric device(s), read-only, and forwards new punches to the central API over HTTPS (docs/plans/PHASE_2.md, P2-F).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts run",
    "start": "tsx src/main.ts run",
    "agent": "tsx src/main.ts",
    "fake-device": "tsx src/dev/fakeDeviceCli.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fake-api": "tsx src/dev/fakeApiCli.ts",
    "build:exe": "node packaging/build-exe.mjs",
    "catalogue": "tsx src/simulator/catalogueCli.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.12.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.4.0",
    "vitest": "^4.1.11",
    "zkteco-js": "1.7.2"
  }
}
