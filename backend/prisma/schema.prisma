// Prisma schema — Phase 1: auth, RBAC, org masters, employees.
// See docs/PROJECT_SPEC.md §2/§3/§9/§11 for the business rules this
// encodes, and docs/PROGRESS.md for what's still open (branch list, PL
// eligibility boundary, etc.) that this schema deliberately keeps
// configurable rather than hardcoding.
//
// Conventions used throughout:
// - id: String @id @default(cuid())
// - createdAt: DateTime @default(now()), updatedAt: DateTime @updatedAt
// - snake_case table/column names via @@map/@map, camelCase in the client
// - @db.Date for business/calendar dates (joining date, DOB, effective-from/
//   to, ...) vs plain DateTime (timestamptz) for true instants (createdAt,
//   expiresAt, lastLoginAt, ...) — mixing these up silently shifts a date by
//   a day depending on server timezone (CLAUDE.md "Timezone/currency" rule).
// - Four partial unique indexes Prisma can't express are added by hand to
//   the generated migration SQL — see the comment on each affected model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// No separate LOCKED value: the 15-minute lockout after 5 failed attempts
// (spec §3.7) is a temporary, self-expiring condition on an otherwise-
// ACTIVE account, represented purely by User.lockedUntil/
// failedLoginAttempts — login checks `lockedUntil > now()` regardless of
// `status`, so there's no separate state to remember to clear.

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SEPARATED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERN
  CONSULTANT
  PROBATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SeparationStatus {
  INITIATED
  COMPLETED
  CANCELLED
}

enum ImportDataset {
  ORG_MASTERS
  EMPLOYEES
  STATUTORY
  BANK
  LEAVE_GRANTS
}

enum ImportBatchStatus {
  VALIDATED
  COMMITTED
}

// ── Identity & auth ─────────────────────────────────────────────────────

model User {
  id                      String     @id @default(cuid())
  employeeId              String     @unique @map("employee_id")
  employee                Employee   @relation(fields: [employeeId], references: [id])
  passwordHash            String?    @map("password_hash")
  status                  UserStatus @default(INVITED)
  failedLoginAttempts     Int        @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?  @map("locked_until")
  totpSecretEncrypted     Bytes?     @map("totp_secret_encrypted")
  totpEnabled             Boolean    @default(false) @map("totp_enabled")
  totpVerifiedAt          DateTime?  @map("totp_verified_at")
  privacyNoticeAcceptedAt DateTime?  @map("privacy_notice_accepted_at")
  lastLoginAt             DateTime?  @map("last_login_at")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  roles                    UserRole[]
  permissionOverrides      UserPermissionOverride[] @relation("UserPermissionOverrides")
  refreshTokens            RefreshToken[]
  invitationTokens         InvitationToken[]
  passwordResets           PasswordResetToken[]
  totpBackupCodes          TotpBackupCode[]
  settingsUpdated          SystemSetting[]
  savedViews               SavedView[]
  notifications            Notification[]
  favourites               UserFavourite[]
  dashboardLayout          DashboardLayout?
  delegationsGiven         WorkflowDelegate[]       @relation("DelegationDelegator")
  delegationsReceived      WorkflowDelegate[]       @relation("DelegationDelegate")
  attendanceManualBranches AttendanceManualBranch[] @relation("AttendanceManualBranchUser")

  @@map("users")
}

// One login account per employee (spec §3: Employee Code + password IS the
// login). Created atomically with its Employee row by the Add Employee
// service — the `User?` optionality on Employee's side is a Prisma artifact
// of the 1:1-via-unique-FK shape, not a real "employee without a user" state.

model Role {
  id          String        @id @default(cuid())
  code        String        @unique // SUPER_ADMIN | HR_ADMIN | HR_EXECUTIVE | PAYROLL_ADMIN | MANAGER | APPROVER | EMPLOYEE
  name        String
  description String?
  isSystem    Boolean       @default(true) @map("is_system") // seeded roles; not user-deletable
  // Phase 5 commit E1: which employees this role's holders see (spec §2).
  // Editable by SUPER_ADMIN only; SUPER_ADMIN itself is always ALL, computed
  // in code (lib/permissions.ts) whatever this column says.
  dataScope   RoleDataScope @default(SELF) @map("data_scope")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "employee.view", "employee.bank.view"
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@map("permissions")
}

enum RoleDataScope {
  SELF
  TEAM
  ALL
}

enum PermissionOverrideEffect {
  GRANT
  REVOKE
}

// Phase 5 commit E1: a per-user exception to what their roles give them —
// GRANT adds a permission, REVOKE removes one. Effective permissions =
// union(role permissions) + GRANTs − REVOKEs (lib/permissions.ts). Never on
// a SUPER_ADMIN holder (who always has everything) and never on yourself.
model UserPermissionOverride {
  id              String                   @id @default(cuid())
  userId          String                   @map("user_id")
  user            User                     @relation("UserPermissionOverrides", fields: [userId], references: [id])
  permissionId    String                   @map("permission_id")
  permission      Permission               @relation(fields: [permissionId], references: [id])
  effect          PermissionOverrideEffect
  reason          String
  createdByUserId String                   @map("created_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at")

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id])
  roleId           String   @map("role_id")
  role             Role     @relation(fields: [roleId], references: [id])
  assignedByUserId String?  @map("assigned_by_user_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@map("user_roles")
}

// A user can hold multiple roles (spec §2); effective permissions = union
// of all held roles' permissions.

model RefreshToken {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id])
  tokenHash         String        @unique @map("token_hash") // raw token never stored
  userAgent         String?       @map("user_agent")
  ipAddress         String?       @map("ip_address")
  expiresAt         DateTime      @map("expires_at")
  revokedAt         DateTime?     @map("revoked_at")
  replacedByTokenId String?       @unique @map("replaced_by_token_id")
  replacedBy        RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  rotatedFrom       RefreshToken? @relation("TokenRotation")
  lastUsedAt        DateTime?     @map("last_used_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// One row = one active session; "active session listing" is
// `WHERE userId = ? AND revokedAt IS NULL AND expiresAt > now()`. Reuse of
// an already-rotated (replacedByTokenId set) token revokes the whole chain.

model InvitationToken {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at") // now + 48h
  usedAt           DateTime? @map("used_at")
  createdByUserId  String?   @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  // What happened to the email that carried this token. `email_sent_at` is set only when a real mail server accepted the message; the console driver (a file on the
  // server, nothing sent) leaves it empty and a failure stores its reason in words, so no screen has to guess whether somebody was really invited.
  emailTo          String?   @map("email_to")
  emailDriver      String?   @map("email_driver")
  emailAttemptedAt DateTime? @map("email_attempted_at")
  emailSentAt      DateTime? @map("email_sent_at")
  emailError       String?   @map("email_error")

  @@index([userId])
  @@map("invitation_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// Requested by Employee Code, not personal email — personalEmail is not
// unique (see EmployeePersonal), so the request form resolves an Employee
// Code to that one employee's personalEmail and sends there. No ambiguity,
// no email-enumeration surface.

model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("totp_backup_codes")
}

model AuditLog {
  id               String   @id @default(cuid())
  // null = system/scheduler/CLI action. Deliberately NOT a foreign key
  // (E1.1): the table is append-only, so a row must never depend on — or
  // be changed by — anything happening to the user it names.
  actorUserId      String?  @map("actor_user_id")
  // Set when the actor acted through a workflow delegation (E3): the
  // manager whose approvals they were covering. Not a foreign key, for the
  // same reason as actorUserId.
  onBehalfOfUserId String?  @map("on_behalf_of_user_id")
  action           String
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  before           Json? // always passed through the shared redact() helper before insert — see writeAuditLog()
  after            Json? // ditto
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Append-only. Only writeAuditLog() may insert a row — no other code path
// calls prisma.auditLog.create directly, so redaction can never be skipped.

model SystemSetting {
  key             String   @id
  value           Json
  updatedByUserId String?  @map("updated_by_user_id")
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id])
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// Phase 1 keys: auth.lockoutAttempts, auth.lockoutMinutes,
// auth.passwordMinLength, auth.invitationTtlHours, auth.require2faRoles.

// ── Org masters ─────────────────────────────────────────────────────────

model Company {
  id                String   @id @default(cuid())
  name              String
  legalName         String?  @map("legal_name")
  // The company's PAN and TAN are sealed payroll identifiers (rules COMPANY_PAN and TAN), never plain columns here (P7-0).
  cin               String?
  registeredAddress String?  @map("registered_address")
  logoStorageKey    String?  @map("logo_storage_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("company")
}

// Single row for now — not enforced at DB level, just by the admin UI only
// ever showing one record.

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  state     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations Location[]

  @@map("cities")
}

// Two levels only — city -> branch, not a general tree. Grouping/reporting
// concept (Employee Count by City), independent of any branch's own postal
// address city text. create/edit/merge-near-duplicates in Organisation
// Setup; no isActive here — deactivation is a branch (Location) concept.

model Location {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String   @unique
  cityId             String?  @map("city_id")
  cityMaster         City?    @relation(fields: [cityId], references: [id]) // structured grouping — distinct from `city` below
  addressLine1       String   @map("address_line1")
  addressLine2       String?  @map("address_line2")
  city               String // free-text postal address city (unchanged shape from the original draft)
  state              String
  pincode            String
  isActive           Boolean  @default(true) @map("is_active")
  // Phase 2 (HR 2026-10-08): whether this branch has a biometric machine.
  // Guides the UI only (Add Employee's default "attendance capture", the
  // Devices screen's consistency check). The rules engine never reads it:
  // manual capture = no device mapping in force on the day.
  hasBiometricDevice Boolean  @default(true) @map("has_biometric_device")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  jobHistory          EmployeeJobHistory[]
  manualBranchUsers   AttendanceManualBranch[]
  manualMusterUploads ManualMusterUpload[]
  devices             Device[]
  announcements       Announcement[]
  companyDocuments    CompanyDocument[]

  @@index([cityId])
  @@map("locations")
}

// A branch. Growing, HR-managed list (spec §1) — not a small fixed set.
// `isActive` instead of delete: a closed branch keeps its historical
// EmployeeJobHistory rows intact and just disappears from active dropdowns
// (delete stays blocked outright when referenced). `cityId` is optional and
// independently editable from the branch's own address fields, since the
// postal address city and the reporting-city grouping can legitimately
// differ (e.g. a branch physically in a suburb HR wants grouped under the
// metro city). create/edit/merge-near-duplicates/deactivate all live in
// Organisation Setup (spec §7.8).

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobHistory       EmployeeJobHistory[]
  announcements    Announcement[]
  companyDocuments CompanyDocument[]

  @@map("departments")
}

model Designation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobHistory EmployeeJobHistory[]

  @@map("designations")
}

model Grade {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  rank      Int? // display/seniority ordering
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobHistory EmployeeJobHistory[]

  @@map("grades")
}

model CostCentre {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobHistory EmployeeJobHistory[]

  @@map("cost_centres")
}

// ── Employees ────────────────────────────────────────────────────────────

model Employee {
  bankRepaymentRows BankRepaymentRow[]
  remoteRecords   RemoteAttendanceRecord[]
  id              String                   @id @default(cuid())
  employeeCode    String                   @unique @map("employee_code") // permanent login username — never reassigned, even after separation
  officialEmail   String?                  @unique @map("official_email")
  dateOfJoining   DateTime                 @map("date_of_joining") @db.Date
  lastWorkingDate DateTime?                @map("last_working_date") @db.Date
  // Why they left — set when a separation completes, or directly by the
  // Excel import for ex-employees migrated from greytHR, who have a last
  // working day and a reason but no Separation row here (Phase 5 G prep).
  exitReason      String?                  @map("exit_reason")
  employmentType  EmploymentType           @map("employment_type")
  status          EmployeeStatus           @default(ACTIVE)
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  user            User?
  personal        EmployeePersonal?
  nameHistory     EmployeeNameHistory[]
  statutory       EmployeeStatutory?
  bankAccounts    EmployeeBankAccount[]
  jobHistory      EmployeeJobHistory[]   @relation("EmployeeJobHistoryOwner")
  managedBy       EmployeeJobHistory[]   @relation("EmployeeManager") // reverse: rows where I'm the manager
  deviceMappings  DeviceUserMapping[]
  documents       EmployeeDocument[]
  changeRequests  ProfileChangeRequest[]
  separations     Separation[]
  leaveRequests   LeaveRequest[]         @relation("LeaveRequestOwner")
  leaveLedger     LeaveLedger[]
  compOffCredits  CompOffCredit[]
  yearEndRunItems YearEndRunItem[]

  authoredPosts  Post[]        @relation("PostAuthor")
  subjectOfPosts Post[]        @relation("PostSubject")
  kudosGiven     Kudos[]       @relation("KudosFrom")
  kudosReceived  Kudos[]       @relation("KudosTo")
  pollVotes      PollVote[]
  comments       Comment[]
  reactions      Reaction[]
  groupMembers   GroupMember[]

  companyDocumentDownloads CompanyDocumentDownload[]

  helpdeskTicketsRaised      HelpdeskTicket[]        @relation("HelpdeskTicketRaisedBy")
  helpdeskTicketsAssigned    HelpdeskTicket[]        @relation("HelpdeskTicketAssignee")
  helpdeskMessages           HelpdeskMessage[]
  helpdeskCategoriesAssigned HelpdeskCategory[]      @relation("HelpdeskCategoryDefaultAssignee")
  generatedLetters           GeneratedLetter[]
  attendanceAssignments      AttendanceAssignment[]
  salaries                   EmployeeSalary[]
  payrollAdjustments         PayrollAdjustment[]
  payrollRunItems            PayrollRunItem[]
  payslips                   Payslip[]
  bankTransferRows           BankTransferRow[]
  rawPunches                 RawPunch[]
  dailyAttendance            DailyAttendance[]
  manualAttendanceEntries    ManualAttendanceEntry[]
  regularizationRequests     RegularizationRequest[]
  attendanceOverrides        AttendanceOverride[]
  shiftOverrides             ShiftOverride[]
  leaveDayReleases           LeaveDayRelease[]

  @@index([status])
  @@index([dateOfJoining])
  @@map("employees")
}

// The static identity row. Org placement (dept/designation/location/
// manager/grade/cost-centre) is NEVER stored here — only in
// EmployeeJobHistory — so "who reported to whom, in what role, at what
// branch, as of any date" is always reconstructable, not just the current
// snapshot. A rejoining employee always gets a brand-new row here (new id,
// new employeeCode) — old rows are never reopened or reused.

model EmployeePersonal {
  id                       String   @id @default(cuid())
  employeeId               String   @unique @map("employee_id")
  employee                 Employee @relation(fields: [employeeId], references: [id])
  dateOfBirth              DateTime @map("date_of_birth") @db.Date
  gender                   Gender
  personalEmail            String   @map("personal_email") // NOT unique — see PasswordResetToken
  mobile                   String
  currentAddress           String   @map("current_address")
  permanentAddress         String   @map("permanent_address")
  emergencyContactName     String   @map("emergency_contact_name")
  emergencyContactPhone    String   @map("emergency_contact_phone")
  emergencyContactRelation String   @map("emergency_contact_relation")
  bloodGroup               String?  @map("blood_group")
  // Photo objects are only ever written by the photo upload endpoint
  // (modules/people/photos.ts), which re-encodes the image with sharp and
  // strips all metadata — never settable as a raw key through any other
  // API, or a caller could point it at someone else's stored file.
  photoStorageKey          String?  @map("photo_storage_key") // re-encoded 512px WebP
  photoThumbStorageKey     String?  @map("photo_thumb_storage_key") // 96x96 WebP for the directory/org chart
  photoVersion             String?  @map("photo_version") // changes on every photo change; cache-busts image URLs
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([personalEmail])
  @@map("employee_personal")
}

// Current-state only (not effective-dated) — every change is still captured
// in audit_logs regardless. Full name lives in EmployeeNameHistory instead
// of here (see below). Address/emergency-contact/photo are employee-
// editable directly; every other field requires HR (ProfileChangeRequest
// for employee-initiated changes to anything else).

model EmployeeNameHistory {
  id              String    @id @default(cuid())
  employeeId      String    @map("employee_id")
  employee        Employee  @relation(fields: [employeeId], references: [id])
  fullName        String    @map("full_name")
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date // null = current
  changeReason    String?   @map("change_reason")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([employeeId, effectiveTo])
  @@map("employee_name_history")
}

// Effective-dated so a payslip/letter generated in the past still shows the
// name as of its own date after a later name change (e.g. marriage). Read
// through one shared helper, resolveCurrentFullName(employeeId, asOfDate?),
// used everywhere a name is displayed — never read ad hoc. Migration SQL
// adds a partial unique index: one open row per employee —
// (employee_id) WHERE effective_to IS NULL.

model EmployeeStatutory {
  id               String   @id @default(cuid())
  employeeId       String   @unique @map("employee_id")
  employee         Employee @relation(fields: [employeeId], references: [id])
  panEncrypted     Bytes?   @map("pan_encrypted")
  panLast4         String?  @map("pan_last4")
  panHash          String?  @unique @map("pan_hash") // HMAC-SHA256(normalised PAN, FIELD_HASH_PEPPER) — dedup + exact-match only
  aadhaarEncrypted Bytes?   @map("aadhaar_encrypted")
  aadhaarLast4     String?  @map("aadhaar_last4")
  aadhaarHash      String?  @unique @map("aadhaar_hash")
  uanEncrypted     Bytes?   @map("uan_encrypted")
  uanLast4         String?  @map("uan_last4")
  updatedByUserId  String?  @map("updated_by_user_id") // who last wrote this row (P6-6): the Setup sign-off cannot be given by someone who entered what it covers
  esiEncrypted     Bytes?   @map("esi_encrypted") // encrypted like the UAN since Phase 7 P7-0 (user decision 2026-10-22; it was plaintext before)
  esiLast4         String?  @map("esi_last4")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("employee_statutory")
}

// Grids/lists read panLast4/aadhaarLast4/uanLast4 only — never decrypt to
// render a list. panHash/aadhaarHash are global-unique (one EmployeeStatutory
// row per employee, no history here) so no two employees can share a PAN or
// Aadhaar. The reveal endpoint is the only path that decrypts, and is
// audit-logged every time.

model EmployeeBankAccount {
  id                     String    @id @default(cuid())
  employeeId             String    @map("employee_id")
  employee               Employee  @relation(fields: [employeeId], references: [id])
  accountHolderName      String    @map("account_holder_name")
  accountNumberEncrypted Bytes     @map("account_number_encrypted")
  accountNumberLast4     String    @map("account_number_last4")
  accountNumberHash      String    @map("account_number_hash") // HMAC-SHA256(normalised account number, FIELD_HASH_PEPPER)
  ifsc                   String
  bankName               String    @map("bank_name")
  branchName             String    @map("branch_name")
  effectiveFrom          DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo            DateTime? @map("effective_to") @db.Date
  createdByUserId        String    @map("created_by_user_id")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([employeeId, effectiveTo])
  @@index([accountNumberHash])
  @@map("employee_bank_accounts")
}

// Effective-dated: changing bank details closes the current row and inserts
// a new one — never an in-place update. Migration SQL adds two partial
// unique indexes:
//   1. one open row per employee — (employee_id) WHERE effective_to IS NULL
//   2. no two employees share the same *active* account —
//      (account_number_hash) WHERE effective_to IS NULL
// (2) is scoped to open rows only, so an employee can legitimately re-adopt
// an account they used years ago without colliding with their own closed
// history.

model EmployeeJobHistory {
  id                 String      @id @default(cuid())
  employeeId         String      @map("employee_id")
  employee           Employee    @relation("EmployeeJobHistoryOwner", fields: [employeeId], references: [id])
  departmentId       String      @map("department_id")
  department         Department  @relation(fields: [departmentId], references: [id])
  designationId      String      @map("designation_id")
  designation        Designation @relation(fields: [designationId], references: [id])
  locationId         String      @map("location_id")
  location           Location    @relation(fields: [locationId], references: [id])
  gradeId            String?     @map("grade_id")
  grade              Grade?      @relation(fields: [gradeId], references: [id])
  costCentreId       String?     @map("cost_centre_id")
  costCentre         CostCentre? @relation(fields: [costCentreId], references: [id])
  reportingManagerId String?     @map("reporting_manager_id")
  reportingManager   Employee?   @relation("EmployeeManager", fields: [reportingManagerId], references: [id])
  effectiveFrom      DateTime    @map("effective_from") @db.Date
  effectiveTo        DateTime?   @map("effective_to") @db.Date
  changeReason       String?     @map("change_reason")
  createdByUserId    String      @map("created_by_user_id")
  createdAt          DateTime    @default(now()) @map("created_at")

  @@index([employeeId, effectiveTo])
  @@index([reportingManagerId])
  @@index([departmentId, effectiveTo])
  @@index([locationId, effectiveTo])
  @@map("employee_job_history")
}

// Effective-dated dept/designation/location/manager per spec §11, extended
// to also carry grade + cost centre since both are org-placement attributes
// that change on promotion/transfer the same way. Migration SQL adds a
// partial unique index: one open row per employee —
// (employee_id) WHERE effective_to IS NULL.

model DeviceUserMapping {
  id              String    @id @default(cuid())
  employeeId      String    @map("employee_id")
  employee        Employee  @relation(fields: [employeeId], references: [id])
  deviceUserId    String    @map("device_user_id") // raw biometric machine user ID, e.g. "1042"
  validFrom       DateTime  @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date // null = currently active
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([deviceUserId])
  @@index([employeeId])
  @@map("device_user_mappings")
}

// Phase 1 schema groundwork for Phase 2's ingestion (spec §4.3), added now
// because Employee Code's permanence otherwise breaks under device ID
// reuse — see spec §3. Migration SQL adds a partial unique index: one
// active mapping per device ID — (device_user_id) WHERE valid_to IS NULL.
// raw_punches/devices tables themselves are still Phase 2, not built here.

// Per-employee files HR keeps (letters, ID proofs, …) — Phase 5 commit C.
// HR-only uploads; the employee sees a document only when HR marks it
// visibleToEmployee. Archived, never deleted.
model EmployeeDocument {
  id                String           @id @default(cuid())
  employeeId        String           @map("employee_id")
  employee          Employee         @relation(fields: [employeeId], references: [id])
  categoryId        String           @map("category_id")
  category          DocumentCategory @relation(fields: [categoryId], references: [id])
  title             String
  fileKey           String           @map("file_key") // StorageService key
  fileName          String           @map("file_name")
  mimeType          String           @map("mime_type")
  sizeBytes         Int              @map("size_bytes")
  visibleToEmployee Boolean          @default(false) @map("visible_to_employee")
  uploadedByUserId  String           @map("uploaded_by_user_id")
  uploadedAt        DateTime         @default(now()) @map("uploaded_at")
  archivedAt        DateTime?        @map("archived_at")
  archivedByUserId  String?          @map("archived_by_user_id")
  generatedLetter   GeneratedLetter?

  @@index([employeeId])
  @@map("employee_documents")
}

model ProfileChangeRequest {
  id                String              @id @default(cuid())
  employeeId        String              @map("employee_id")
  employee          Employee            @relation(fields: [employeeId], references: [id])
  requestedByUserId String              @map("requested_by_user_id")
  fieldGroup        String              @map("field_group") // "bank" | "statutory" | "personal"
  changesJson       Json                @map("changes_json") // always passed through redact() — see createProfileChangeRequest()
  status            ChangeRequestStatus @default(PENDING)
  remarks           String?
  decidedByUserId   String?             @map("decided_by_user_id")
  decidedAt         DateTime?           @map("decided_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([employeeId, status])
  @@map("profile_change_requests")
}

model Separation {
  id                String           @id @default(cuid())
  employeeId        String           @map("employee_id")
  employee          Employee         @relation(fields: [employeeId], references: [id])
  lastWorkingDate   DateTime         @map("last_working_date") @db.Date
  reason            String
  notes             String?
  status            SeparationStatus @default(INITIATED)
  initiatedByUserId String           @map("initiated_by_user_id")
  initiatedAt       DateTime         @default(now()) @map("initiated_at")
  cancelledAt       DateTime?        @map("cancelled_at")
  completedAt       DateTime?        @map("completed_at")

  @@index([employeeId])
  @@map("separations")
}

// Multiple rows per employee are correct (rejoin). A rejoin always gets a
// brand-new Employee row rather than reopening this one — see Employee.

model SavedView {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  gridKey   String   @map("grid_key") // e.g. "employees" — one grid today, room for more later
  name      String
  config    Json // { filters, columns, sortBy, sortDir }
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, gridKey, name])
  @@index([userId, gridKey])
  @@map("saved_views")
}

// Personal, per-user grid preferences (All Employees grid's "saved views" —
// spec §7.2). Not effective-dated, not audited — this is UI convenience
// state, not business data.

// ── Import Center ────────────────────────────────────────────────────────

model ImportBatch {
  id                String            @id @default(cuid())
  dataset           ImportDataset
  fileName          String            @map("file_name")
  status            ImportBatchStatus @default(VALIDATED)
  totalRows         Int               @map("total_rows")
  validRows         Int               @map("valid_rows")
  errorRows         Int               @map("error_rows")
  uploadedByUserId  String            @map("uploaded_by_user_id")
  uploadedAt        DateTime          @default(now()) @map("uploaded_at")
  committedByUserId String?           @map("committed_by_user_id")
  committedAt       DateTime?         @map("committed_at")

  rows ImportStagingRow[]

  @@index([dataset, status])
  @@map("import_batches")
}

// One row per parsed spreadsheet row (spec §10), kept only long enough to
// validate, download as an error report, and commit. Sensitive fields
// (bank account number, PAN, Aadhaar) are never stored here as plaintext:
// row validation immediately transforms them into the same encrypted/
// last4/hash shape the live tables use — the identical pack/unpack pattern
// already used by employee/changeRequests.ts's changesJson — so a staging
// row can leak no more than the committed table would, and the downloadable
// error report (which echoes `data` back to HR) never has a plaintext
// account number to echo in the first place.
model ImportStagingRow {
  id        String      @id @default(cuid())
  batchId   String      @map("batch_id")
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int         @map("row_number")
  data      Json // parsed row fields, dataset-specific shape — see import/parse.ts
  errors    Json // string[] — blocks commit for this row when non-empty
  warnings  Json // string[] — informational only (e.g. near-duplicate name), never blocks
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([batchId])
  @@map("import_staging_rows")
}

// ── Leave (Phase 4) ─────────────────────────────────────────────────────
// spec §5. Built ahead of Phase 2 (biometric/attendance) since the device
// model isn't known yet — CLAUDE.md's "keep it configurable, don't guess"
// rule blocks Phase 2, not this. Two real dependencies on Phase 2 (approved
// leave marking attendance days; comp-off crediting from worked holidays/
// week-offs) are bridged by an interface in modules/leave/
// attendanceIntegration.ts + compOff.ts — a no-op stub today, a drop-in
// real implementation later, no migration required either way.

model LeaveType {
  id           String   @id @default(cuid())
  code         String   @unique // "PL", "LOP", "COF", "WFH", "RH" — seeded, not hardcoded elsewhere
  name         String
  isPaid       Boolean  @default(true) @map("is_paid") // false for LOP
  allowHalfDay Boolean  @default(true) @map("allow_half_day")
  isActive     Boolean  @default(true) @map("is_active") // soft-disable — ledger/request history must survive a retired type
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  policy        LeavePolicy?
  ledgerEntries LeaveLedger[]
  leaveRequests LeaveRequest[]
  dayReleases   LeaveDayRelease[]

  @@map("leave_types")
}

enum LeaveEligibilityMode {
  DAYS // eligibilityValue = calendar days from DOJ (HR's confirmed PL rule: 90)
  CALENDAR_MONTHS // eligibilityValue = whole months from DOJ
}

// One row per leave type — a single typed table rather than 5 polymorphic
// ones, since the catalog is exactly 5 fixed types and most columns are
// null for a type that doesn't use them (see the comment block per field
// group below). Not effective-dated: leave_ledger (append-only) is the
// historical record; Leave Recalculator replays it after a policy change
// rather than the policy itself being versioned.
model LeavePolicy {
  id          String    @id @default(cuid())
  leaveTypeId String    @unique @map("leave_type_id")
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  // PL accrual — only meaningful when accrualEnabled = true (PL)
  accrualEnabled         Boolean               @default(false) @map("accrual_enabled")
  accrualDaysPerMonth    Decimal?              @map("accrual_days_per_month") @db.Decimal(5, 2) // 1.00
  eligibilityMode        LeaveEligibilityMode? @map("eligibility_mode") // DAYS
  eligibilityValue       Int?                  @map("eligibility_value") // 90
  carryForwardCapDays    Decimal?              @map("carry_forward_cap_days") @db.Decimal(5, 2) // null = uncapped
  negativeBalanceAllowed Boolean               @default(false) @map("negative_balance_allowed")
  skipBalanceCheck       Boolean               @default(false) @map("skip_balance_check") // true for LOP only —
  // LOP has no balance concept at all rather than an "unlimited" number; apply/approve never call the
  // balance-check function for a type with this set
  yearEndEncashment      Boolean               @default(false) @map("year_end_encashment") // true for PL only

  // Comp-off (COF only) — hours/expiry pending HR confirmation, see docs/PROGRESS.md open questions
  compOffMinHoursWorked Decimal? @map("comp_off_min_hours_worked") @db.Decimal(4, 2) // default 4.00
  compOffExpiryDays     Int?     @map("comp_off_expiry_days") // default 60

  // WFH (WFH only) — limits pending HR confirmation
  wfhMonthlyLimit Int? @map("wfh_monthly_limit") // default null = unlimited
  wfhYearlyLimit  Int? @map("wfh_yearly_limit") // default null = unlimited

  // Restricted Holiday (RH only) — quota pending HR confirmation
  rhYearlyQuota Int? @map("rh_yearly_quota") // default 2

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_policies")
}

enum LeaveLedgerEntryType {
  OPENING
  ACCRUAL
  CONSUMED
  REVERSAL
  GRANT
  DEBIT
  CARRY_FORWARD // reserved — unused by Phase 4's own logic; see leave_ledger's comment below
  ENCASHMENT
  LAPSE // reserved — unused by Phase 4's own logic; see leave_ledger's comment below
  EXPIRY
}

// The source of truth (spec §5.3). Balance for (employee, leaveType) as of
// any date = SUM(days) WHERE entry_date <= asOfDate — full history, no
// year-scoped partition. leaveYear is a reporting/filter tag only, never
// the balance-computation boundary — see the Year End section for exactly
// where that distinction matters (a January accrual must never leak into
// the prior December's encashment cutoff). This also makes "carry forward
// with no cap" free: there is no carry-forward operation, just the absence
// of any entry that would reduce the running balance.
//
// CARRY_FORWARD/LAPSE are reserved for scenarios Phase 4 doesn't need yet:
// a capped-carry-forward type forfeiting the excess at year-end, or a
// greytHR data-migration opening balance (§10) — not emitted by anything
// built in this phase. RH defaults to carry-forward (no lapse) until HR
// confirms whether unused RH should lapse at year-end.
model LeaveLedger {
  id              String               @id @default(cuid())
  employeeId      String               @map("employee_id")
  employee        Employee             @relation(fields: [employeeId], references: [id])
  leaveTypeId     String               @map("leave_type_id")
  leaveType       LeaveType            @relation(fields: [leaveTypeId], references: [id])
  leaveYear       Int                  @map("leave_year")
  entryDate       DateTime             @map("entry_date") @db.Date
  accrualMonth    DateTime?            @map("accrual_month") @db.Date // ACCRUAL rows only — the 1st of the
  // credited month; the real idempotency key (not entryDate, which can shift if a job runs late/retries)
  entryType       LeaveLedgerEntryType @map("entry_type")
  days            Decimal              @db.Decimal(5, 2) // signed: +credit, -debit
  referenceType   String?              @map("reference_type") // "LEAVE_REQUEST" | "YEAR_END_RUN" |
  // "MANUAL_GRANT" | "ACCRUAL_JOB" | "RECALCULATION" — polymorphic string pair, same convention as
  // AuditLog.entityType/entityId (no real FK: points at different tables depending on the row)
  referenceId     String?              @map("reference_id")
  compOffCreditId String?              @map("comp_off_credit_id") // real FK (unlike referenceType/Id above,
  // this always points at the same table when set) — COF CONSUMED/EXPIRY rows only, set per-lot so a
  // cancellation's reversal knows exactly which lot to credit back
  compOffCredit   CompOffCredit?       @relation(fields: [compOffCreditId], references: [id])
  remarks         String?
  createdByUserId String?              @map("created_by_user_id") // null = system/scheduler (accrual job,
  // expiry job) — same nullable-actor convention as AuditLog.actorUserId
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([employeeId, leaveTypeId])
  @@index([employeeId, entryDate])
  @@index([referenceType, referenceId])
  @@index([compOffCreditId])
  @@map("leave_ledger")
}

// Migration SQL adds a partial unique index — the monthly accrual job's
// idempotency backstop (spec §5.5): one ACCRUAL row per
// (employee, leaveType, accrualMonth) —
// (employee_id, leave_type_id, accrual_month) WHERE entry_type = 'ACCRUAL'.

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveDayPart {
  FULL
  FIRST_HALF
  SECOND_HALF
}

model LeaveRequest {
  id                      String             @id @default(cuid())
  employeeId              String             @map("employee_id") // who the leave is FOR
  employee                Employee           @relation("LeaveRequestOwner", fields: [employeeId], references: [id])
  leaveTypeId             String             @map("leave_type_id")
  leaveType               LeaveType          @relation(fields: [leaveTypeId], references: [id])
  fromDate                DateTime           @map("from_date") @db.Date
  toDate                  DateTime           @map("to_date") @db.Date
  fromDayPart             LeaveDayPart       @default(FULL) @map("from_day_part")
  toDayPart               LeaveDayPart       @default(FULL) @map("to_day_part") // only meaningful when fromDate !=
  // toDate; single-day requests use fromDayPart and validate toDayPart == fromDayPart at the Zod layer
  totalDays               Decimal            @map("total_days") @db.Decimal(5, 2) // computed at apply time —
  // excludes leave_types' holidays and a configurable default week-off pattern until Phase 2's real
  // per-employee week_off_patterns exists, see modules/leave/attendanceIntegration.ts
  reason                  String?
  attachmentStorageKey    String?            @map("attachment_storage_key")
  status                  LeaveRequestStatus @default(PENDING)
  appliedByUserId         String             @map("applied_by_user_id") // usually the employee; HR/manager when
  // applying on behalf of (leave.apply.onBehalf)
  decidedByUserId         String?            @map("decided_by_user_id")
  // E3: the manager whose approvals decidedBy was covering, when the
  // decision was reached through a workflow delegation.
  decidedOnBehalfOfUserId String?            @map("decided_on_behalf_of_user_id")
  decidedAt               DateTime?          @map("decided_at")
  decisionComments        String?            @map("decision_comments")
  cancelledByUserId       String?            @map("cancelled_by_user_id")
  cancelledAt             DateTime?          @map("cancelled_at")
  cancellationReason      String?            @map("cancellation_reason")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  dayReleases             LeaveDayRelease[]

  @@index([employeeId, status])
  @@index([fromDate, toDate])
  @@index([status])
  @@map("leave_requests")
}

// Overlap prevention (no two PENDING/APPROVED requests for one employee on
// overlapping dates) is an application-level check inside the same locked
// transaction as apply/approve (see modules/leave/concurrency.ts) — not a
// DB constraint. Postgres range-exclusion needs the btree_gist extension,
// which nothing else in this schema uses; a tested service-layer check
// under a row lock is consistent with how the rest of this schema handles
// cross-row invariants that aren't a single-row uniqueness fact.

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@map("holidays")
}

model RestrictedHoliday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@map("restricted_holidays")
}

// Company-wide, not per-branch (HR-confirmed 2026-09-28 — see docs/
// PROJECT_SPEC.md §1/§7.8 and docs/PROGRESS.md's Phase 4 commit D log:
// holidays, leave policies, shifts, week-off patterns and attendance
// rules are identical for every branch; a branch's only real difference
// is which biometric device its punches come from, a device-to-branch
// mapping Phase 2 owns, not a policy difference). An employee "applies"
// for an RH via a normal LeaveRequest (leaveType = RH, fromDate = toDate
// = one of these dates), validated against this one list and
// leave_policies.rh_yearly_quota — no separate selection table needed.

enum CompOffCreditStatus {
  AVAILABLE // remainingDays > 0, not expired
  CONSUMED // remainingDays reached 0 via FIFO leave-approval consumption
  EXPIRED // remainingDays force-debited by the daily expiry job past expiresOn
}

enum CompOffCreditSource {
  MANUAL_GRANT
  ATTENDANCE // unused until Phase 2 — see modules/leave/compOff.ts
}

// One row per earned comp-off "lot", tracking its own expiry and its own
// remaining balance independently of the fungible ledger sum — spec lists
// this as its own table. Consumption is FIFO (oldest earnedDate first) at
// the moment a COF leave request is approved: remainingDays is decremented
// per lot, one LeaveLedger CONSUMED row is written per lot touched (via
// compOffCreditId), so cancellation-reversal and expiry both know exactly
// which lot's remainingDays to adjust — never a guess, never a defensive
// re-check against the aggregate ledger balance.
model CompOffCredit {
  id              String              @id @default(cuid())
  employeeId      String              @map("employee_id")
  employee        Employee            @relation(fields: [employeeId], references: [id])
  earnedDate      DateTime            @map("earned_date") @db.Date // the holiday/week-off actually worked
  earnedDays      Decimal             @map("earned_days") @db.Decimal(3, 2) // original amount, immutable
  remainingDays   Decimal             @map("remaining_days") @db.Decimal(3, 2) // FIFO-decremented; drives status
  expiresOn       DateTime            @map("expires_on") @db.Date // earnedDate + policy.compOffExpiryDays,
  // resolved at credit time
  status          CompOffCreditStatus @default(AVAILABLE)
  source          CompOffCreditSource @map("source")
  grantedByUserId String?             @map("granted_by_user_id") // set when source = MANUAL_GRANT
  ledgerEntryId   String              @unique @map("ledger_entry_id") // the GRANT row this credit created
  createdAt       DateTime            @default(now()) @map("created_at")

  consumptions LeaveLedger[]

  @@index([employeeId, status])
  @@index([expiresOn])
  @@map("comp_off_credits")
}

enum YearEndRunStatus {
  PREVIEW
  SUPERSEDED // a newer preview was generated for the same year, or HR explicitly discarded this one
  COMMITTED
}

// Preview -> (optionally superseded/discarded, re-previewable) -> commit.
// Mirrors ImportBatch/ImportStagingRow's parent/child + status-lifecycle
// pattern. PREVIEW never writes to leave_ledger — it only computes and
// stores into YearEndRunItem; leave_ledger is written exactly once, at
// commit, which re-verifies the closing balance hasn't drifted since
// preview before writing anything (see modules/leave/yearEnd.ts).
model YearEndRun {
  id                  String           @id @default(cuid())
  leaveYear           Int              @map("leave_year")
  status              YearEndRunStatus @default(PREVIEW)
  previewedByUserId   String           @map("previewed_by_user_id")
  previewedAt         DateTime         @default(now()) @map("previewed_at")
  supersededAt        DateTime?        @map("superseded_at")
  committedByUserId   String?          @map("committed_by_user_id")
  committedAt         DateTime?        @map("committed_at")
  totalEmployees      Int              @map("total_employees")
  totalEncashedDays   Decimal          @map("total_encashed_days") @db.Decimal(10, 2)
  totalEncashedAmount Decimal          @map("total_encashed_amount") @db.Decimal(12, 2)
  reportStorageKey    String?          @map("report_storage_key") // via StorageService, same interface Phase 1
  // already uses for documents
  createdAt           DateTime         @default(now()) @map("created_at")

  items YearEndRunItem[]

  @@map("year_end_runs")
}

// Migration SQL adds a partial unique index — only one COMMITTED run per
// year: (leave_year) WHERE status = 'COMMITTED'. Multiple PREVIEW/
// SUPERSEDED rows per year are fine (harmless historical snapshots).

model YearEndRunItem {
  id                      String     @id @default(cuid())
  yearEndRunId            String     @map("year_end_run_id")
  yearEndRun              YearEndRun @relation(fields: [yearEndRunId], references: [id], onDelete: Cascade)
  employeeId              String     @map("employee_id")
  employee                Employee   @relation(fields: [employeeId], references: [id])
  closingPlBalance        Decimal    @map("closing_pl_balance") @db.Decimal(5, 2)
  encashedDays            Decimal    @map("encashed_days") @db.Decimal(5, 2) // == closingPlBalance (no cap today)
  dailyRate               Decimal    @map("daily_rate") @db.Decimal(10, 2) // resolved via EncashmentRateProvider
  // at preview time
  rateSource              String     @map("rate_source") // "MANUAL_SETTING" today; "SALARY_STRUCTURE" once
  // Phase 6 supplies a real provider — snapshot so switching providers never retroactively changes history
  encashedAmount          Decimal    @map("encashed_amount") @db.Decimal(12, 2)
  ledgerEncashmentEntryId String?    @unique @map("ledger_encashment_entry_id") // set only once committed;
  // null on a mere preview — one ENCASHMENT ledger entry per employee, debiting the full balance to 0, IS
  // the "reset for the new year" — no separate reset entry needed

  @@index([yearEndRunId])
  @@map("year_end_run_items")
}

// ── Phase 5 — Notifications, Announcements, Admin Homepage ──────────────

// Persisted per spec §8 ("every notification is also persisted in
// notifications... and optionally emailed"). This row is the durable
// record; Socket.IO's `notification.new` event (realtime/emit.ts) is
// delivery on top of it, never the write itself — every write path calls
// modules/notifications' createNotification() directly, as its own step,
// before it emits, so a notification exists whether or not anyone is
// connected to hear about it.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  type      String // namespaced event-shaped string, e.g. "leave.decided" — not a fixed enum, so a new
  // notification type never needs a migration
  title     String
  body      String
  link      String? // client-side route to navigate to on click
  payload   Json? // event-specific structured data, so the frontend never has to re-fetch to render it
  readAt    DateTime? @map("read_at") // null = unread
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// The Home page's HR-managed banner (spec §6), replacing greytHR's
// product-ad slot. Multiple rows can have overlapping active windows and
// scopes — modules/announcements/service.ts resolves exactly one for a
// given viewer: most specific scope wins (ranked by how many of
// scopeLocationId/scopeDepartmentId are set and match), ties break on
// the most recent activeFrom. A row with both scope columns null is
// org-wide and always the least specific match.
model Announcement {
  id                String      @id @default(cuid())
  title             String
  body              String
  linkLabel         String?     @map("link_label")
  linkUrl           String?     @map("link_url")
  scopeLocationId   String?     @map("scope_location_id")
  scopeLocation     Location?   @relation(fields: [scopeLocationId], references: [id], onDelete: Restrict)
  scopeDepartmentId String?     @map("scope_department_id")
  scopeDepartment   Department? @relation(fields: [scopeDepartmentId], references: [id], onDelete: Restrict)
  activeFrom        DateTime    @map("active_from") @db.Date
  activeTo          DateTime    @map("active_to") @db.Date
  isActive          Boolean     @default(true) @map("is_active") // HR can pause without losing the configured date range
  createdByUserId   String      @map("created_by_user_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([scopeLocationId])
  @@index([scopeDepartmentId])
  @@index([activeFrom, activeTo])
  @@map("announcements")
}

// Personal widget visibility/order for the Admin Dashboard tab's "Edit"
// button (spec §7.1) — one row per user (a personal customization, not a
// global admin setting), created lazily on first save.
model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  layout    Json // ordered array of { key: string, visible: boolean }, one entry per known widget
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dashboard_layouts")
}

// Admin Homepage "My Favourites" shortcut tiles (spec §7.1) — user-
// configurable, not a fixed admin-defined list.
model UserFavourite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  label     String
  icon      String // key into a fixed frontend icon set — never a free-form URL/SVG upload
  path      String // client-side route
  rank      Int      @default(0) // display order, lower first
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, rank])
  @@map("user_favourites")
}

// ── Phase 5 commit B — Engage (spec §4, §7.7) ──────────────────────────

enum PostKind {
  USER
  KUDOS
  POLL
  AUTO_BIRTHDAY
  AUTO_JOINING
  AUTO_ANNIVERSARY
}

// A lightweight named category posts can be tagged with (e.g. "Events",
// "Milestones") — membership is informational (who's "in" a group, for a
// future "my groups" view) and does NOT gate who can post into or see a
// group's posts; the feed itself stays org-wide with client-side/query
// filters. Deliberately not access-controlled: nothing in this phase asks
// for closed-membership groups, and building that now would be an
// unrequested feature.
model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members GroupMember[]
  posts   Post[]

  @@map("groups")
}

model GroupMember {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  group      Group    @relation(fields: [groupId], references: [id])
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  joinedAt   DateTime @default(now()) @map("joined_at")

  @@unique([groupId, employeeId])
  @@map("group_members")
}

// The feed's one uniform row — a plain USER post, a KUDOS/POLL post
// (structured data lives in the 1:1 Kudos/Poll row via postId), or a
// system-generated AUTO_* celebration. authorEmployeeId is null for
// AUTO_* kinds (nobody "wrote" it); subjectEmployeeId + occurredOn are
// set only for AUTO_* kinds — occurredOn is the calendar date being
// celebrated (not createdAt), and is the idempotency key alongside kind +
// subjectEmployeeId (hand-added partial unique index in the migration —
// see autoPosts.ts for the 29-Feb-birthday and mid-loop-failure rules
// this protects against).
//
// Moderation is a soft hide, never a delete (this codebase's standing
// append-only convention — YearEndRun SUPERSEDED, Location.isActive):
// moderatedAt/moderatedByUserId get set, the row and its backing Kudos/
// Poll/Comment/Reaction rows stay in the database. Every feed query and
// every count derived from a Post (kudos-given/received included) filters
// on moderatedAt IS NULL — never a stored counter, so a moderated post's
// kudos stop counting immediately with no separate decrement to get
// wrong.
model Post {
  id                String    @id @default(cuid())
  authorEmployeeId  String?   @map("author_employee_id")
  author            Employee? @relation("PostAuthor", fields: [authorEmployeeId], references: [id])
  subjectEmployeeId String?   @map("subject_employee_id")
  subject           Employee? @relation("PostSubject", fields: [subjectEmployeeId], references: [id])
  groupId           String?   @map("group_id")
  group             Group?    @relation(fields: [groupId], references: [id])
  kind              PostKind
  body              String
  occurredOn        DateTime? @map("occurred_on") @db.Date
  moderatedAt       DateTime? @map("moderated_at")
  moderatedByUserId String?   @map("moderated_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  kudos     Kudos?
  poll      Poll?
  comments  Comment[]
  reactions Reaction[]

  @@index([createdAt])
  @@index([groupId])
  @@index([kind])
  @@map("posts")
}

model Kudos {
  id             String   @id @default(cuid())
  postId         String   @unique @map("post_id")
  post           Post     @relation(fields: [postId], references: [id])
  fromEmployeeId String   @map("from_employee_id")
  fromEmployee   Employee @relation("KudosFrom", fields: [fromEmployeeId], references: [id])
  toEmployeeId   String   @map("to_employee_id")
  toEmployee     Employee @relation("KudosTo", fields: [toEmployeeId], references: [id])
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([toEmployeeId])
  @@map("kudos")
}

model Poll {
  id        String    @id @default(cuid())
  postId    String    @unique @map("post_id")
  post      Post      @relation(fields: [postId], references: [id])
  question  String
  closesAt  DateTime? @map("closes_at")
  closedAt  DateTime? @map("closed_at") // set when explicitly closed — independent of closesAt lapsing
  createdAt DateTime  @default(now()) @map("created_at")

  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id     String @id @default(cuid())
  pollId String @map("poll_id")
  poll   Poll   @relation(fields: [pollId], references: [id])
  label  String
  rank   Int    @default(0)

  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id           String     @id @default(cuid())
  pollId       String     @map("poll_id") // denormalized off PollOption.pollId so one employee->poll vote is a plain unique index, not a cross-table check
  poll         Poll       @relation(fields: [pollId], references: [id])
  pollOptionId String     @map("poll_option_id")
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id])
  employeeId   String     @map("employee_id")
  employee     Employee   @relation(fields: [employeeId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([pollId, employeeId])
  @@map("poll_votes")
}

model Comment {
  id               String   @id @default(cuid())
  postId           String   @map("post_id")
  post             Post     @relation(fields: [postId], references: [id])
  authorEmployeeId String   @map("author_employee_id")
  author           Employee @relation(fields: [authorEmployeeId], references: [id])
  body             String
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([postId])
  @@map("comments")
}

// One row per (post, employee) — picking a different emoji replaces the
// existing reaction; clicking the same emoji again removes it (toggle),
// both handled in reactions.ts's upsert-or-delete, never a second row.
model Reaction {
  id         String   @id @default(cuid())
  postId     String   @map("post_id")
  post       Post     @relation(fields: [postId], references: [id])
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([postId, employeeId])
  @@map("reactions")
}

enum AutoPostKind {
  BIRTHDAY
  JOINING
  ANNIVERSARY
}

// Admin-configurable per-kind template + enabled flag (spec §7.7's
// "configure auto-posts (joining, birthday, anniversary templates and
// time)") — a closed catalog of exactly 3 rows, same shape as
// LeavePolicy's one-row-per-fixed-type pattern. `template` supports
// {name} (and {years} for ANNIVERSARY) placeholders substituted by
// autoPosts.ts at generation time. The shared daily-batch run hour (for
// BIRTHDAY/ANNIVERSARY; JOINING fires on-event, not on this cron) lives
// in SystemSetting `engage.autopost.dailyRunHour`, not here — see
// jobs/scheduler.ts.
model EngageAutoPostSetting {
  kind      AutoPostKind @id
  enabled   Boolean      @default(true)
  template  String
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("engage_auto_post_settings")
}

// ── Documents (Phase 5 commit C) ─────────────────────────────────────────

enum DocumentCategoryScope {
  COMPANY // company policies, forms — CompanyDocument
  EMPLOYEE // letters, ID proofs — EmployeeDocument
}

// What an EMPLOYEE category's documents may contain, and so who may ever
// read them (2026-10-03, user decision — structural, never per document):
// GENERAL anyone with employee.documents.view in scope; PAY (anything with
// money in it: offer and increment letters, payslips) also needs
// documents.pay.view; STATUTORY (ID proofs: PAN, Aadhaar) also needs
// employee.statutory.view. Neither key is manager-grantable, so a manager
// never sees PAY or STATUTORY documents whatever they're granted. New
// categories default to PAY; sensitivity can be raised, never lowered.
// COMPANY categories are always GENERAL (company documents are for everyone).
enum DocumentSensitivity {
  GENERAL
  PAY
  STATUTORY
}

// Admin-editable master (standing rule: nothing hardcoded). Deactivated,
// never deleted, once any document references it.
model DocumentCategory {
  id          String                @id @default(cuid())
  code        String                @unique
  name        String
  appliesTo   DocumentCategoryScope @map("applies_to")
  sensitivity DocumentSensitivity   @default(PAY)
  isActive    Boolean               @default(true) @map("is_active")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  companyDocuments  CompanyDocument[]
  employeeDocuments EmployeeDocument[]

  @@map("document_categories")
}

// Document Center's company-wide files. Audience uses the same rule as
// Announcement: a null scope column matches everyone, a set one must match
// the employee's current job row, both set = the intersection.
model CompanyDocument {
  id                String           @id @default(cuid())
  title             String
  description       String?
  categoryId        String           @map("category_id")
  category          DocumentCategory @relation(fields: [categoryId], references: [id])
  fileKey           String           @map("file_key")
  fileName          String           @map("file_name")
  mimeType          String           @map("mime_type")
  sizeBytes         Int              @map("size_bytes")
  scopeLocationId   String?          @map("scope_location_id")
  scopeLocation     Location?        @relation(fields: [scopeLocationId], references: [id], onDelete: Restrict)
  scopeDepartmentId String?          @map("scope_department_id")
  scopeDepartment   Department?      @relation(fields: [scopeDepartmentId], references: [id], onDelete: Restrict)
  uploadedByUserId  String           @map("uploaded_by_user_id")
  uploadedAt        DateTime         @default(now()) @map("uploaded_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  archivedAt        DateTime?        @map("archived_at")
  archivedByUserId  String?          @map("archived_by_user_id")

  downloads CompanyDocumentDownload[]

  @@index([categoryId])
  @@map("company_documents")
}

// Who has downloaded which company document — one row per (document,
// employee), upserted on every download. Deliberately not an audit_logs
// row per click: this answers "who has read the new policy" directly,
// without acknowledgement (out of scope) and without flooding the audit log.
model CompanyDocumentDownload {
  id                String          @id @default(cuid())
  documentId        String          @map("document_id")
  document          CompanyDocument @relation(fields: [documentId], references: [id])
  employeeId        String          @map("employee_id")
  employee          Employee        @relation(fields: [employeeId], references: [id])
  firstDownloadedAt DateTime        @default(now()) @map("first_downloaded_at")
  lastDownloadedAt  DateTime        @default(now()) @map("last_downloaded_at")
  downloadCount     Int             @default(1) @map("download_count")

  @@unique([documentId, employeeId])
  @@map("company_document_downloads")
}

// ── Helpdesk (Phase 5 commit D) ──────────────────────────────────────────

enum HelpdeskTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_EMPLOYEE
  RESOLVED
  CLOSED
}

enum HelpdeskPriority {
  LOW
  NORMAL
  HIGH
}

// Admin-editable. isSensitive (e.g. Payroll & Salary, Grievance) limits the
// category's tickets to holders of helpdesk.sensitive.view — configurable
// per category, never hardcoded. Deactivated, not deleted, once used.
model HelpdeskCategory {
  id                        String    @id @default(cuid())
  code                      String    @unique
  name                      String
  isSensitive               Boolean   @default(false) @map("is_sensitive")
  /// Owner decision: tickets in this category are the directors' alone. HR never sees them, whatever else it holds; only a director can change this flag.
  directorsOnly             Boolean   @default(false) @map("directors_only")
  defaultAssigneeEmployeeId String?   @map("default_assignee_employee_id")
  defaultAssignee           Employee? @relation("HelpdeskCategoryDefaultAssignee", fields: [defaultAssigneeEmployeeId], references: [id])
  isActive                  Boolean   @default(true) @map("is_active")
  sortOrder                 Int       @default(0) @map("sort_order")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  tickets HelpdeskTicket[]

  @@map("helpdesk_categories")
}

model HelpdeskTicket {
  id                 String               @id @default(cuid())
  number             Int                  @unique @default(autoincrement()) // shown as HD-000123
  raisedByEmployeeId String               @map("raised_by_employee_id")
  raisedBy           Employee             @relation("HelpdeskTicketRaisedBy", fields: [raisedByEmployeeId], references: [id])
  categoryId         String               @map("category_id")
  category           HelpdeskCategory     @relation(fields: [categoryId], references: [id])
  subject            String
  priority           HelpdeskPriority     @default(NORMAL)
  status             HelpdeskTicketStatus @default(OPEN)
  assigneeEmployeeId String?              @map("assignee_employee_id")
  assignee           Employee?            @relation("HelpdeskTicketAssignee", fields: [assigneeEmployeeId], references: [id])
  resolvedAt         DateTime?            @map("resolved_at")
  closedAt           DateTime?            @map("closed_at")
  lastActivityAt     DateTime             @default(now()) @map("last_activity_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  messages HelpdeskMessage[]

  @@index([raisedByEmployeeId])
  @@index([assigneeEmployeeId])
  @@index([status, resolvedAt])
  @@map("helpdesk_tickets")
}

// The chat-style thread. isInternalNote messages are HR-only: excluded
// server-side from every employee-facing response, never just hidden.
model HelpdeskMessage {
  id               String         @id @default(cuid())
  ticketId         String         @map("ticket_id")
  ticket           HelpdeskTicket @relation(fields: [ticketId], references: [id])
  authorEmployeeId String         @map("author_employee_id")
  author           Employee       @relation(fields: [authorEmployeeId], references: [id])
  body             String
  isInternalNote   Boolean        @default(false) @map("is_internal_note")
  createdAt        DateTime       @default(now()) @map("created_at")

  attachments HelpdeskAttachment[]

  @@index([ticketId, createdAt])
  @@map("helpdesk_messages")
}

// Same pipeline as Document Center uploads (lib/uploads.ts): size/type/
// extension/magic-byte checks, and images re-encoded with sharp so no
// EXIF/GPS survives — a photographed payslip or ID is the exact leak case.
model HelpdeskAttachment {
  id        String          @id @default(cuid())
  messageId String          @map("message_id")
  message   HelpdeskMessage @relation(fields: [messageId], references: [id])
  fileKey   String          @map("file_key")
  fileName  String          @map("file_name")
  mimeType  String          @map("mime_type")
  sizeBytes Int             @map("size_bytes")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([messageId])
  @@map("helpdesk_attachments")
}

// ── Letters (Phase 5 commit D2) ──────────────────────────────────────────
// Letters are legal documents (user, 2026-10-01): every issued letter can be
// reproduced from what's stored here, and nothing issued is ever replaced.
// Database triggers (migration add_letters_phase5_commit_d2) make template
// versions and issued letters immutable, and freeze an employee document's
// file once written.

model LetterTemplate {
  id                       String                  @id @default(cuid())
  code                     String                  @unique
  name                     String
  description              String?
  isActive                 Boolean                 @default(true) @map("is_active")
  visibleToEmployeeDefault Boolean                 @default(true) @map("visible_to_employee_default")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  versions                 LetterTemplateVersion[]

  @@map("letter_templates")
}

// Append-only: editing a template always adds a version. The current
// version is the highest `version` number.
model LetterTemplateVersion {
  id              String            @id @default(cuid())
  templateId      String            @map("template_id")
  template        LetterTemplate    @relation(fields: [templateId], references: [id])
  version         Int
  bodyHtml        String            @map("body_html") // sanitized on save
  extraFields     Json              @map("extra_fields") // [{ key, label, type, required }]
  createdByUserId String?           @map("created_by_user_id") // null for seeded versions
  createdAt       DateTime          @default(now()) @map("created_at")
  letters         GeneratedLetter[]

  @@unique([templateId, version])
  @@map("letter_template_versions")
}

enum GeneratedLetterStatus {
  QUEUED
  GENERATED
  FAILED
}

model GeneratedLetter {
  id                 String                @id @default(cuid())
  number             Int                   @unique @default(autoincrement()) // shown as LTR-000123
  employeeId         String                @map("employee_id")
  employee           Employee              @relation(fields: [employeeId], references: [id])
  templateVersionId  String                @map("template_version_id")
  templateVersion    LetterTemplateVersion @relation(fields: [templateVersionId], references: [id])
  mergeValues        Json                  @map("merge_values") // every value merged in, incl. typed extras + letterhead snapshot
  generatedAt        DateTime              @map("generated_at") // the letter's date; fixed at request time
  generatedByUserId  String                @map("generated_by_user_id")
  visibleToEmployee  Boolean               @map("visible_to_employee")
  status             GeneratedLetterStatus @default(QUEUED)
  failureReason      String?               @map("failure_reason")
  employeeDocumentId String?               @unique @map("employee_document_id")
  // Restrict: an issued letter's document can never be deleted out from under it.
  employeeDocument   EmployeeDocument?     @relation(fields: [employeeDocumentId], references: [id], onDelete: Restrict)
  pdfSha256          String?               @map("pdf_sha256")
  rendererVersion    String?               @map("renderer_version")
  reissueOfId        String?               @map("reissue_of_id")
  reissueOf          GeneratedLetter?      @relation("LetterReissue", fields: [reissueOfId], references: [id], onDelete: SetNull)
  reissues           GeneratedLetter[]     @relation("LetterReissue")
  createdAt          DateTime              @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("generated_letters")
}

// Phase 5 commit E1.1: a security-relevant event that must not go unnoticed
// — today the break-glass CLIs (admin:recover, admin:bootstrap). Each row
// shows a red banner to every Super Admin until a Super Admin OTHER than the
// target acknowledges it. Append-only (database trigger): only the three
// acknowledgement columns may be filled in, once. No foreign keys, so a row
// outlives anything it mentions.
model SecurityEvent {
  id                   String    @id @default(cuid())
  kind                 String // "break_glass.recover" | "break_glass.bootstrap"
  targetUserId         String?   @map("target_user_id")
  summary              String
  details              Json
  createdAt            DateTime  @default(now()) @map("created_at")
  acknowledgedAt       DateTime? @map("acknowledged_at")
  acknowledgedByUserId String?   @map("acknowledged_by_user_id")
  acknowledgementNote  String?   @map("acknowledgement_note")

  @@index([acknowledgedAt])
  @@map("security_events")
}

// Phase 5 commit E1.1: one row, written only by prisma/seed.ts (which
// refuses to run outside development), marks a development/CI database.
// The append-only triggers on audit_logs and security_events let the test
// suite delete its own fixture rows only when this row exists — so a
// never-seeded staging/production database has no exception at all.
model DevDatabaseMarker {
  id        Int      @id @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("dev_database_marker")
}

// Workflow delegation (Phase 5 commit E3): a manager's approvals covered
// by someone else for an inclusive date range. Never grants a permission —
// the delegate must already hold leave.approve; it only widens whose team
// their TEAM scope resolves against in the approval flows
// (modules/delegations/reach.ts). Never deleted: revoking records who/when.
model WorkflowDelegate {
  id              String    @id @default(cuid())
  delegatorUserId String    @map("delegator_user_id")
  delegator       User      @relation("DelegationDelegator", fields: [delegatorUserId], references: [id])
  delegateUserId  String    @map("delegate_user_id")
  delegate        User      @relation("DelegationDelegate", fields: [delegateUserId], references: [id])
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  reason          String?
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  revokedByUserId String?   @map("revoked_by_user_id")
  revokeReason    String?   @map("revoke_reason")

  @@index([delegatorUserId])
  @@index([delegateUserId])
  @@map("workflow_delegates")
}

// ── Attendance configuration (Phase 2 commit P2-A; docs/plans/PHASE_2.md §2.1) ──
// Company-wide (HR 2026-09-28): shifts, week-off patterns and rules are the
// same for every branch. Admin-configurable, audited, deactivated never
// deleted. Fields still awaiting HR are listed in `placeholderFields` and
// shown as "placeholder — awaiting HR" until someone sets them.

enum ShiftSessionKind {
  WORK
  BREAK
}

model Shift {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  name                String
  startTime           String                 @map("start_time") // "HH:MM", local business time
  endTime             String                 @map("end_time") // "HH:MM"; <= start → crosses midnight
  graceInMinutes      Int                    @default(0) @map("grace_in_minutes")
  graceOutMinutes     Int                    @default(0) @map("grace_out_minutes")
  windowBeforeMinutes Int                    @default(240) @map("window_before_minutes") // punch window opens start − this
  windowAfterMinutes  Int                    @default(360) @map("window_after_minutes") // and closes end + this
  placeholderFields   Json                   @default("[]") @map("placeholder_fields") // e.g. ["graceInMinutes"] until HR confirms
  isActive            Boolean                @default(true) @map("is_active")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  sessions            ShiftSession[]
  assignments         AttendanceAssignment[]
  overrides           ShiftOverride[]

  @@map("shifts")
}

// The shift's parts, in order: work sessions and the scheduled breaks between
// them (GEN: 10:00–14:00 work, 14:00–14:45 lunch, 14:45–19:00 work). The
// first work session is the first half, the last the second half; scheduled
// breaks covered by someone's IN–OUT span are deducted from actual work,
// since our device sends no direction (spec §4.1).
model ShiftSession {
  id        String           @id @default(cuid())
  shiftId   String           @map("shift_id")
  shift     Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  sortOrder Int              @map("sort_order")
  kind      ShiftSessionKind
  label     String
  startTime String           @map("start_time")
  endTime   String           @map("end_time")

  @@unique([shiftId, sortOrder])
  @@map("shift_sessions")
}

// Week-off pattern rules: [{ weekday: 0..6 (0 = Sunday), weeks?: [1..5] }]
// — no `weeks` = every week; weeks = which occurrences in the month (e.g. 2nd
// and 4th Saturday). HR 2026-10-08: Sunday off, Monday–Saturday working.
model WeekOffPattern {
  id          String                 @id @default(cuid())
  code        String                 @unique
  name        String
  rules       Json
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  assignments AttendanceAssignment[]

  @@map("week_off_patterns")
}

// The rule set (greytHR's "attendance scheme"). HR 2026-10-08: no late
// penalty — `penaltyRules` stays empty; lateness is recorded and visible.
model AttendancePolicy {
  id                      String                 @id @default(cuid())
  code                    String                 @unique
  name                    String
  fullDayMinMinutes       Int                    @map("full_day_min_minutes")
  halfDayMinMinutes       Int                    @map("half_day_min_minutes")
  halfDayMinNotMetLopDays Decimal                @default(1) @map("half_day_min_not_met_lop_days") @db.Decimal(3, 2)
  nearDuplicateSeconds    Int                    @default(120) @map("near_duplicate_seconds")
  inferBreakPairing       Boolean                @default(false) @map("infer_break_pairing")
  penaltyRules            Json                   @default("[]") @map("penalty_rules")
  futureToleranceMinutes  Int                    @default(10) @map("future_tolerance_minutes")
  maxPunchAgeDays         Int                    @default(45) @map("max_punch_age_days")
  placeholderFields       Json                   @default("[]") @map("placeholder_fields")
  isActive                Boolean                @default(true) @map("is_active")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  assignments             AttendanceAssignment[]

  @@map("attendance_policies")
}

// Effective-dated per employee: which shift, week-off pattern and policy
// apply from when. A history table under the effective-dating model
// (lib/effectiveDating.ts): half-open rows, one writer, no overlaps
// (migration constraint), read only through assignmentOn/assignmentSegments.
model AttendanceAssignment {
  id               String           @id @default(cuid())
  employeeId       String           @map("employee_id")
  employee         Employee         @relation(fields: [employeeId], references: [id])
  shiftId          String           @map("shift_id")
  shift            Shift            @relation(fields: [shiftId], references: [id])
  weekOffPatternId String           @map("week_off_pattern_id")
  weekOffPattern   WeekOffPattern   @relation(fields: [weekOffPatternId], references: [id])
  policyId         String           @map("policy_id")
  policy           AttendancePolicy @relation(fields: [policyId], references: [id])
  effectiveFrom    DateTime         @map("effective_from") @db.Date
  effectiveTo      DateTime?        @map("effective_to") @db.Date
  changeReason     String?          @map("change_reason")
  createdByUserId  String           @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([employeeId, effectiveTo])
  @@map("attendance_assignments")
}

// The attendance cycle (the period finalised and paid). Effective-dated
// rules so a change applies from a future cycle boundary and past cycles
// keep their boundaries. startDay 1 = calendar month (user-confirmed
// 2026-10-08); 26 = 26th to 25th.
model AttendanceCycleRule {
  id              String   @id @default(cuid())
  effectiveFrom   DateTime @unique @map("effective_from") @db.Date
  startDay        Int      @map("start_day")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("attendance_cycle_rules")
}

// Which branches someone holding attendance.manual.enter may mark (HR
// 2026-10-08: one manager marks SPN and Wellsure 2 only). Company-wide
// holders (ALL data scope) may mark every branch.
model AttendanceManualBranch {
  userId           String   @map("user_id")
  user             User     @relation("AttendanceManualBranchUser", fields: [userId], references: [id], onDelete: Cascade)
  locationId       String   @map("location_id")
  location         Location @relation(fields: [locationId], references: [id])
  assignedByUserId String   @map("assigned_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@id([userId, locationId])
  @@map("attendance_manual_branches")
}

// ── Biometric ingestion (Phase 2 commit P2-B; docs/plans/PHASE_2.md §2.2, §3) ──
// Three routes (the LAN sync agent, ADMS push, an emergency file upload)
// converge on one ingestion service. Raw punches are immutable as received.

enum DeviceRoute {
  AGENT // polled on the LAN by a sync agent (the primary route)
  PUSH // the device pushes to /iclock/* (ADMS)
}

enum PunchRoute {
  AGENT
  PUSH
  IMPORT
}

enum PunchFlag {
  FUTURE // more than the tolerance ahead of the server clock when received
  TOO_OLD // older than the plausible age when received
}

enum PunchFlagDecision {
  ACCEPTED
  DISCARDED
}

enum IngestionBatchStatus {
  PREVIEW // a file upload parsed and counted, nothing stored yet
  COMMITTED
}

// A sync agent on an office PC. Its API key is shown once and stored only as
// a hash, like any credential.
model BiometricAgent {
  id              String    @id @default(cuid())
  name            String
  keyHash         String    @unique @map("key_hash")
  keyPrefix       String    @map("key_prefix") // first characters, to tell keys apart on screen
  host            String?
  version         String?
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  lastHeartbeat   Json?     @map("last_heartbeat") // the agent's last report: reachability, cursor lag, clock offset, retention
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  devices   Device[]
  batches   IngestionBatch[]
  incidents DeviceIncident[]

  @@map("biometric_agents")
}

// A biometric machine, at exactly one branch (spec §7.3).
model Device {
  id               String          @id @default(cuid())
  serialNumber     String          @unique @map("serial_number") // ADMS authenticates on it
  name             String
  locationId       String          @map("location_id")
  location         Location        @relation(fields: [locationId], references: [id])
  timezone         String          @default("Asia/Kolkata")
  model            String? // free text until the model is known (spec §14)
  firmware         String?
  route            DeviceRoute     @default(AGENT)
  agentId          String?         @map("agent_id")
  agent            BiometricAgent? @relation(fields: [agentId], references: [id])
  lanIp            String?         @map("lan_ip")
  isSimulated      Boolean         @default(false) @map("is_simulated") // refused on production; the engine never reads it
  isActive         Boolean         @default(true) @map("is_active")
  lastHeartbeatAt  DateTime?       @map("last_heartbeat_at")
  lastPunchAt      DateTime?       @map("last_punch_at") // the latest punch time received
  lastReceivedAt   DateTime?       @map("last_received_at") // when anything last arrived from it
  // P2-F (docs/plans/PHASE_2.md "P2-F build design"). The agent never sends a
  // punch dated before syncFrom (D-F3); moving it earlier makes it re-send.
  syncFrom         DateTime        @default(dbgenerated("((now() AT TIME ZONE 'Asia/Kolkata'::text))::date")) @map("sync_from") @db.Date
  // The device's log retention, pessimistic until the model is known (§7.1).
  retentionDays    Int             @default(3) @map("retention_days")
  retentionRecords Int             @default(20000) @map("retention_records")
  // The sync agent's latest report on this device (state, last read, clock
  // offset, log count/capacity, backlog, retention), with when it arrived.
  agentReport      Json?           @map("agent_report")
  agentReportAt    DateTime?       @map("agent_report_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  punches   RawPunch[]
  batches   IngestionBatch[]
  incidents DeviceIncident[]

  @@index([agentId])
  @@map("devices")
}

// What kind of trouble a DeviceIncident records (spec §4.7, docs/plans/PHASE_2.md "P2-H build design").
enum DeviceIncidentKind {
  DEVICE_SILENT // no successful contact with the device for N minutes during its working hours
  AGENT_SILENT // the sync agent's heartbeat missed for N minutes
  NO_PUNCHES_TODAY // the morning check: reachable, expected people, but no punch today
  CLOCK_DRIFT // the device's clock is beyond the threshold
  RETENTION_RISK // the device's log is at risk of overwriting punches nobody has read, or is nearly full
}

// One stretch of trouble with a device or an agent: opened by the health check,
// closed when it clears, never deleted. At most one is open per subject and
// kind (a partial unique index in the migration), so "once per incident" is a
// property of the table. Exactly one of deviceId / agentId is set (AGENT_SILENT
// has the agent, every other kind has the device).
model DeviceIncident {
  id                 String             @id @default(cuid())
  kind               DeviceIncidentKind
  deviceId           String?            @map("device_id")
  device             Device?            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  agentId            String?            @map("agent_id")
  agent              BiometricAgent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  openedAt           DateTime           @map("opened_at")
  // When the subject was last seen working, so the gap can be reported honestly (the incident opens N minutes after it).
  lastContactAt      DateTime?          @map("last_contact_at")
  resolvedAt         DateTime?          @map("resolved_at")
  // The numbers behind it (minutes silent, offset seconds, ...), and what the recovery found.
  details            Json               @default("{}")
  openNotifiedAt     DateTime?          @map("open_notified_at")
  // The start of the next working day after it opened: if it is still open then, one fresh notification (escalatedAt).
  escalateAfter      DateTime?          @map("escalate_after")
  escalatedAt        DateTime?          @map("escalated_at")
  recoveryNotifiedAt DateTime?          @map("recovery_notified_at")
  recoverySummary    Json?              @map("recovery_summary")
  createdAt          DateTime           @default(now()) @map("created_at")

  @@index([resolvedAt])
  @@index([deviceId, openedAt])
  @@index([agentId, openedAt])
  @@map("device_incidents")
}

// One per agent post, ADMS upload or file import.
model IngestionBatch {
  id               String               @id @default(cuid())
  route            PunchRoute
  status           IngestionBatchStatus @default(COMMITTED)
  deviceId         String               @map("device_id")
  device           Device               @relation(fields: [deviceId], references: [id])
  agentId          String?              @map("agent_id")
  agent            BiometricAgent?      @relation(fields: [agentId], references: [id])
  uploadedByUserId String?              @map("uploaded_by_user_id") // IMPORT only
  fileName         String?              @map("file_name")
  reason           String? // IMPORT: why the emergency upload was needed
  receivedAt       DateTime             @default(now()) @map("received_at")
  committedAt      DateTime?            @map("committed_at")
  totalLines       Int                  @default(0) @map("total_lines")
  newCount         Int                  @default(0) @map("new_count")
  duplicateCount   Int                  @default(0) @map("duplicate_count")
  unmappedCount    Int                  @default(0) @map("unmapped_count")
  rejectedCount    Int                  @default(0) @map("rejected_count")
  flaggedCount     Int                  @default(0) @map("flagged_count")
  rejectedLines    Json                 @default("[]") @map("rejected_lines") // kept verbatim for HR
  pendingText      String?              @map("pending_text") // PREVIEW only: the file, until committed

  punches RawPunch[]

  @@index([deviceId, receivedAt])
  @@map("ingestion_batches")
}

// spec §4.2. Immutable as received: a database trigger refuses DELETE, and
// any UPDATE except re-resolving employee_id (a device ID mapped later,
// docs/plans/PHASE_2.md §2.2). Unique (device, device user, instant) is the
// exact-duplicate layer that makes retries and overlapping files idempotent.
model RawPunch {
  id           String         @id @default(cuid())
  deviceId     String         @map("device_id")
  device       Device         @relation(fields: [deviceId], references: [id])
  deviceUserId String         @map("device_user_id")
  punchedAt    DateTime       @map("punched_at") @db.Timestamptz(3)
  localTime    String         @map("local_time") // exactly as the device recorded it
  businessDate DateTime       @map("business_date") @db.Date // the date in the device's zone, used for mapping
  direction    String         @default("UNKNOWN") // our device sends none (spec §4.1)
  status       String
  verifyMode   String         @map("verify_mode")
  workcode     String
  reserved     String
  rawLine      String         @map("raw_line")
  route        PunchRoute // audit only; never read downstream
  batchId      String         @map("batch_id")
  batch        IngestionBatch @relation(fields: [batchId], references: [id])
  receivedAt   DateTime       @default(now()) @map("received_at")
  employeeId   String?        @map("employee_id") // via employeeForDeviceUserOn(deviceUserId, businessDate); null = unmapped
  employee     Employee?      @relation(fields: [employeeId], references: [id])
  flag         PunchFlag?

  flagResolution PunchFlagResolution?

  @@unique([deviceId, deviceUserId, punchedAt])
  @@index([employeeId, punchedAt])
  @@index([deviceUserId, businessDate])
  @@index([deviceId, businessDate]) // the every-minute "any punches today?" count and the per-day device views (P2-J)
  @@map("raw_punches")
}

// HR's decision on a flagged (implausible-time) punch: accepted into
// computation, or discarded. Kept apart so the punch itself never changes.
model PunchFlagResolution {
  punchId         String            @id @map("punch_id")
  punch           RawPunch          @relation(fields: [punchId], references: [id])
  decision        PunchFlagDecision
  reason          String?
  decidedByUserId String            @map("decided_by_user_id")
  decidedAt       DateTime          @default(now()) @map("decided_at")

  @@map("punch_flag_resolutions")
}

// ── The day record (Phase 2 commit P2-C; docs/plans/PHASE_2.md §2.3, §4) ──

enum AttendanceSource {
  DEVICE
  MANUAL
  LEAVE
  HOLIDAY
  WEEK_OFF
  OVERRIDE // corrected by hand: a regularization or a manual override (Phase 3)
}

enum AttendanceCapture {
  DEVICE
  MANUAL
}

// One row per employee per business date, written only by the rules engine
// (modules/attendance/engine). Fully derivable from raw punches, manual
// entries, approved leave, holidays, assignments and rule values — nothing is
// ever typed into it. A locked row (Phase 3 finalisation) is never rewritten.
model DailyAttendance {
  id               String            @id @default(cuid())
  employeeId       String            @map("employee_id")
  employee         Employee          @relation(fields: [employeeId], references: [id])
  date             DateTime          @db.Date
  // The shift as used that day (a snapshot: later edits to the shift don't change history until recomputed).
  shiftId          String?           @map("shift_id")
  shiftCode        String?           @map("shift_code")
  shiftStart       String?           @map("shift_start")
  shiftEnd         String?           @map("shift_end")
  policyId         String?           @map("policy_id")
  firstIn          DateTime?         @map("first_in") @db.Timestamptz(3)
  lastOut          DateTime?         @map("last_out") @db.Timestamptz(3)
  totalMinutes     Int?              @map("total_minutes")
  breakMinutes     Int?              @map("break_minutes")
  actualMinutes    Int?              @map("actual_minutes")
  inShiftMinutes   Int?              @map("in_shift_minutes")
  lateInMinutes    Int?              @map("late_in_minutes")
  earlyOutMinutes  Int?              @map("early_out_minutes")
  shortfallMinutes Int?              @map("shortfall_minutes")
  excessMinutes    Int?              @map("excess_minutes")
  status           String // P, A, HD, H, O, NM, NS, a leave code, or a split such as A:P / PL:P
  firstHalfStatus  String?           @map("first_half_status")
  secondHalfStatus String?           @map("second_half_status")
  lopDays          Decimal           @default(0) @map("lop_days") @db.Decimal(3, 2)
  exceptionFlags   String[]          @default([]) @map("exception_flags")
  source           AttendanceSource
  capture          AttendanceCapture
  leaveTypeCode    String?           @map("leave_type_code")
  holidayName      String?           @map("holiday_name")
  workedOnOffDay   Boolean           @default(false) @map("worked_on_off_day")
  provisional      Boolean           @default(false) // computed while the shift window was still open
  punchCount       Int               @default(0) @map("punch_count")
  computedFrom     Json              @default("{}") @map("computed_from") // punch ids, manual entry id, collapsed/outside counts — for "Info"
  // An override applied to the day (P2-E: MISSING_PUNCH_CORRECTION, an approved
  // forgot-to-punch request; Phase 3 adds manual overrides) and what it was.
  overrideKind     String?           @map("override_kind")
  overrideRef      String?           @map("override_ref")
  shiftOverrideRef String?           @map("shift_override_ref") // set when the day's shift came from a Shift Override
  isLocked         Boolean           @default(false) @map("is_locked") // Phase 3 finalisation
  processedAt      DateTime          @default(now()) @map("processed_at")
  engineVersion    Int               @map("engine_version")

  @@unique([employeeId, date])
  @@index([date])
  @@map("daily_attendance")
}

enum AttendanceProcessStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// Process Attendance (docs/plans/PHASE_2.md §3.1): re-run the engine for a
// date range at any time before the period is locked. Audited: who, range,
// why, and what changed.
model AttendanceProcessRun {
  id                String                  @id @default(cuid())
  fromDate          DateTime                @map("from_date") @db.Date
  toDate            DateTime                @map("to_date") @db.Date
  employeeIds       String[]                @default([]) @map("employee_ids") // empty = everyone employed in the range
  locationId        String?                 @map("location_id")
  reason            String
  status            AttendanceProcessStatus @default(QUEUED)
  requestedByUserId String                  @map("requested_by_user_id")
  requestedAt       DateTime                @default(now()) @map("requested_at")
  startedAt         DateTime?               @map("started_at")
  finishedAt        DateTime?               @map("finished_at")
  totalDays         Int                     @default(0) @map("total_days") // employee-days in scope
  processedDays     Int                     @default(0) @map("processed_days")
  changedDays       Int                     @default(0) @map("changed_days")
  lockedDays        Int                     @default(0) @map("locked_days") // in scope but locked, left alone
  changes           Json                    @default("[]") // the first changed days: employee, date, before → after status
  error             String?

  @@index([requestedAt])
  @@map("attendance_process_runs")
}

// ── Manual attendance (Phase 2 commit P2-D; docs/plans/PHASE_2.md §2.3, §5) ──
// For manual-capture employees (no device mapping in force on the day): the
// muster's entries. Append-only (a trigger refuses UPDATE and DELETE); the
// latest entry per employee-day wins, every earlier one stays as history.

enum ManualEntryKind {
  TIMED // actual IN (and OUT) times — through the same rules as device punches
  STATUS_ONLY // P, A, HD_FIRST, HD_SECOND or WORKED — "status only, no times"
  CLEARED // withdraws the entry: the day returns to NM
}

enum ManualEntryVia {
  SCREEN // typed into the Attendance Muster
  MUSTER_UPLOAD // the Import Center's muster template
  BULK // "Mark all present"
}

model ManualAttendanceEntry {
  id              String              @id @default(cuid())
  seq             Int                 @unique @default(autoincrement()) // the "latest wins" order
  employeeId      String              @map("employee_id")
  employee        Employee            @relation(fields: [employeeId], references: [id])
  date            DateTime            @db.Date
  kind            ManualEntryKind
  inTime          String?             @map("in_time") // "HH:MM" business time
  outTime         String?             @map("out_time") // at or before inTime = next day
  status          String? // STATUS_ONLY: P, A, HD_FIRST, HD_SECOND, WORKED
  via             ManualEntryVia
  uploadId        String?             @map("upload_id")
  upload          ManualMusterUpload? @relation(fields: [uploadId], references: [id])
  remark          String?
  enteredByUserId String              @map("entered_by_user_id")
  enteredAt       DateTime            @default(now()) @map("entered_at") @db.Timestamptz(3)

  @@index([employeeId, date, seq])
  @@map("manual_attendance_entries")
}

enum ManualMusterUploadStatus {
  PREVIEW
  COMMITTED
}

// One upload of the muster template (a branch and a cycle): parsed and
// previewed, then committed once. Cells are kept until commit.
model ManualMusterUpload {
  id               String                   @id @default(cuid())
  locationId       String                   @map("location_id")
  location         Location                 @relation(fields: [locationId], references: [id])
  cycleStart       DateTime                 @map("cycle_start") @db.Date
  cycleEnd         DateTime                 @map("cycle_end") @db.Date
  fileName         String                   @map("file_name")
  status           ManualMusterUploadStatus @default(PREVIEW)
  pendingCells     Json?                    @map("pending_cells") // the changes to write on commit
  summary          Json                     @default("{}")
  uploadedByUserId String                   @map("uploaded_by_user_id")
  uploadedAt       DateTime                 @default(now()) @map("uploaded_at")
  committedAt      DateTime?                @map("committed_at")
  entries          ManualAttendanceEntry[]

  @@map("manual_muster_uploads")
}

// ── Regularization (spec §4.4, "regularization_requests") ──
// One request type for any correctable device-capture day (Phase 3 commit 1):
// a reason code, a free-text note, and either corrected times (one or both) or
// a target status. Decided by the employee's manager (by grant) or HR, never
// one's own; approval appends an attendance_overrides row and recomputes the
// day. Raw punches are never altered.

enum RegularizationReasonCode {
  FORGOT_TO_PUNCH
  DEVICE_DOWN
  ON_DUTY_ELSEWHERE
  OTHER
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model RegularizationRequest {
  id              String                   @id @default(cuid())
  employeeId      String                   @map("employee_id")
  employee        Employee                 @relation(fields: [employeeId], references: [id])
  date            DateTime                 @db.Date
  reasonCode      RegularizationReasonCode @map("reason_code")
  inTime          String?                  @map("in_time") // "HH:MM" business time
  outTime         String?                  @map("out_time")
  targetStatus    String?                  @map("target_status") // P, A, HD_FIRST, HD_SECOND (instead of times)
  reason          String                   @default("") // the free-text note
  status          RegularizationStatus     @default(PENDING)
  raisedByUserId  String                   @map("raised_by_user_id")
  decidedByUserId String?                  @map("decided_by_user_id")
  decidedAt       DateTime?                @map("decided_at")
  decisionNote    String?                  @map("decision_note")
  batchId         String?                  @map("batch_id")
  batch           RegularizationBatch?     @relation(fields: [batchId], references: [id])
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  override        AttendanceOverride?

  @@index([employeeId, date])
  @@index([status])
  @@index([batchId])
  @@map("regularization_requests")
}

// One HR action over many employee-days (typically a whole branch after a device outage).
model RegularizationBatch {
  id              String                   @id @default(cuid())
  createdByUserId String                   @map("created_by_user_id")
  action          String // RAISED | RAISED_AND_APPROVED
  reasonCode      RegularizationReasonCode @map("reason_code")
  note            String
  fromDate        DateTime                 @map("from_date") @db.Date
  toDate          DateTime                 @map("to_date") @db.Date
  employeeCount   Int                      @map("employee_count")
  dayCount        Int                      @map("day_count")
  createdAt       DateTime                 @default(now()) @map("created_at")
  requests        RegularizationRequest[]

  @@map("regularization_batches")
}

enum OverrideOrigin {
  REGULARIZATION
  MANUAL_OVERRIDE
}

enum OverrideKind {
  ADD_TIME // one time joins the device punches
  TIMES // in and out replace the device punches for the day
  STATUS // the day's status as set
  CLEARED // takes the override away (the day computes from its punches again)
  RELEASE_ONLY // approved leave released because the person worked; the day follows the device's punches (Phase 3 commit 2)
}

// Every day-level correction (Phase 3): a regularization when approved, a manual
// override from commit 2. Append-only like manual_attendance_entries: the latest
// row (highest seq) for an employee-day wins and the history stays. Raw punches
// are never touched; daily_attendance.override_kind / override_ref say which row
// a day was computed with.
model AttendanceOverride {
  id              String                    @id @default(cuid())
  seq             Int                       @unique @default(autoincrement())
  employeeId      String                    @map("employee_id")
  employee        Employee                  @relation(fields: [employeeId], references: [id])
  date            DateTime                  @db.Date
  origin          OverrideOrigin
  kind            OverrideKind
  inTime          String?                   @map("in_time")
  outTime         String?                   @map("out_time")
  status          String? // STATUS: P, A, HD_FIRST, HD_SECOND, WORKED
  reasonCode      RegularizationReasonCode? @map("reason_code")
  reason          String                    @default("")
  requestId       String?                   @unique @map("request_id")
  request         RegularizationRequest?    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  releases        LeaveDayRelease[]
  createdByUserId String                    @map("created_by_user_id")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([employeeId, date, seq])
  @@map("attendance_overrides")
}

// A shift for one employee on one date (Phase 3 commit 2, Shift Override): read by the engine ahead of the
// assignment's shift. Append-only like attendance_overrides — the highest `seq` for an employee-day is the active
// one, and a row with no shift clears the override. History is kept; nothing is edited.
model ShiftOverride {
  id              String   @id @default(cuid())
  seq             Int      @unique @default(autoincrement())
  employeeId      String   @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id])
  date            DateTime @db.Date
  shiftId         String?  @map("shift_id") // null = cleared: the assignment's shift applies again
  shift           Shift?   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  reason          String   @default("")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([employeeId, date, seq])
  @@map("shift_overrides")
}

// Period Finalisation's record (Phase 3 commit 3): every finalise and every unlock of an attendance cycle, append-only.
// A cycle's status is its latest row: none = open, FINALISE = finalised, UNLOCK = open again (who, when, why).
enum PeriodLockAction {
  FINALISE
  UNLOCK
}

model AttendancePeriodLock {
  id              String           @id @default(cuid())
  seq             Int              @unique @default(autoincrement())
  periodStart     DateTime         @map("period_start") @db.Date
  periodEnd       DateTime         @map("period_end") @db.Date
  action          PeriodLockAction
  reason          String           @default("")
  lockedDays      Int              @default(0) @map("locked_days")
  payrollConsumed Boolean          @default(false) @map("payroll_consumed") // an unlock that went ahead although payroll had used the period
  actorUserId     String           @map("actor_user_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([periodStart, periodEnd, seq])
  @@map("attendance_period_locks")
}

// HR released approved leave because the person worked that day (Phase 3 commit 2). One row per leave request and
// part of the day; the leave_ledger REVERSAL it caused points back here (reference_type LEAVE_DAY_RELEASE). The
// engine reads these to stop treating the date as leave for that request; cancelling the request later returns only
// what is still consumed. Never edited or removed: if it was a mistake, leave is applied again.
model LeaveDayRelease {
  id              String             @id @default(cuid())
  employeeId      String             @map("employee_id")
  employee        Employee           @relation(fields: [employeeId], references: [id])
  date            DateTime           @db.Date
  leaveRequestId  String             @map("leave_request_id")
  leaveRequest    LeaveRequest       @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)
  leaveTypeId     String             @map("leave_type_id")
  leaveType       LeaveType          @relation(fields: [leaveTypeId], references: [id])
  dayPart         LeaveDayPart       @map("day_part")
  days            Decimal            @db.Decimal(3, 2) // returned to the balance: 1 for a full day, 0.5 for a half
  overrideId      String             @map("override_id") // the attendance_overrides row written in the same action (two half-day requests on one date share it)
  override        AttendanceOverride @relation(fields: [overrideId], references: [id], onDelete: Restrict)
  reason          String
  createdByUserId String             @map("created_by_user_id")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([leaveRequestId, date, dayPart])
  @@index([employeeId, date])
  @@index([overrideId])
  @@map("leave_day_releases")
}

// ── Payroll foundations (Phase 6 commit P6-1, docs/plans/PHASE_6.md §3, §6) ─────────────────────────
// Governed items: a payroll rule, salary component, salary structure, bank layout or output layout. Every edit appends a version, and a
// version is Confirmed only by a row in payroll_item_confirmations made by somebody other than its author. Runs pin the versions they read.
// Actor columns are plain text, not foreign keys: nothing that happens to a user can alter these rows (as for audit_logs).
enum PayrollItemKind {
  RULE
  RULE_OVERRIDE
  COMPONENT
  STRUCTURE
  BANK_TEMPLATE
  OUTPUT_TEMPLATE
}

enum PayrollApprovalSubject {
  RUN_APPROVAL
  PERIOD_FINALISE
  PAYSLIP_PUBLISH
  BANK_FILE
  PERIOD_UNLOCK
  RULE_CONFIRM
  SALARY_REVISION
  MONTHLY_INPUTS
  BANK_REPAYMENT
}

enum PayrollApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
  CONSUMED
}

model PayrollItemVersion {
  id            String          @id @default(cuid())
  kind          PayrollItemKind
  key           String
  version       Int
  value         Json
  valueHash     String          @map("value_hash")
  note          String          @default("")
  // Where the number came from (the notification, circular or letter), in the author's words, and the date it starts to apply. Required for a statutory rule; confirmed by a different director.
  sourceNote    String          @default("") @map("source_note")
  effectiveFrom DateTime?       @map("effective_from") @db.Date
  authorUserId  String?         @map("author_user_id") // null = the shipped placeholder
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([kind, key, version])
  @@map("payroll_item_versions")
}

model PayrollItemConfirmation {
  id                String          @id @default(cuid())
  kind              PayrollItemKind
  key               String
  version           Int
  valueHash         String          @map("value_hash")
  confirmedByUserId String          @map("confirmed_by_user_id")
  confirmedAt       DateTime        @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  note              String          @default("")
  approvalId        String?         @map("approval_id")
  // D1 (docs/plans/DIRECTOR_AUTHORITY.md): true when the confirmer is the author, which is allowed only to a Super Admin acting under director authority.
  selfConfirmed     Boolean         @default(false) @map("self_confirmed")

  @@unique([kind, key, version])
  @@map("payroll_item_confirmations")
}

model PayrollApproval {
  id                 String                 @id @default(cuid())
  subject            PayrollApprovalSubject
  subjectId          String                 @map("subject_id")
  status             PayrollApprovalStatus  @default(PENDING)
  contentHash        String                 @map("content_hash")
  makerUserId        String                 @map("maker_user_id")
  submittedAt        DateTime               @default(now()) @map("submitted_at") @db.Timestamptz(3)
  submitNote         String                 @default("") @map("submit_note")
  previewFingerprint String                 @map("preview_fingerprint")
  checkerUserId      String?                @map("checker_user_id")
  decidedAt          DateTime?              @map("decided_at") @db.Timestamptz(3)
  decisionNote       String?                @map("decision_note")
  hashAtDecision     String?                @map("hash_at_decision")
  voidedAt           DateTime?              @map("voided_at") @db.Timestamptz(3)
  voidReason         String?                @map("void_reason")
  consumedAt         DateTime?              @map("consumed_at") @db.Timestamptz(3)
  consumedByUserId   String?                @map("consumed_by_user_id")
  // D1: SECOND_DIRECTOR = a different person decided it (the original rule); DIRECTOR_AUTHORITY = one Super Admin prepared and decided it in one act.
  authority          ApprovalAuthority      @default(SECOND_DIRECTOR)

  @@index([subject, subjectId])
  @@map("payroll_approvals")
}

model PayrollEvent {
  id          String   @id @default(cuid())
  seq         Int      @unique @default(autoincrement())
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  type        String
  actorUserId String?  @map("actor_user_id")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId, seq])
  @@map("payroll_events")
}

// ── Salary (Phase 6 commit P6-2, docs/plans/PHASE_6.md §4 and §14B) ─────────────────────────────────
// A person's salary is effective-dated like job, name and bank history: a row covers [effective_from, effective_to). It is written only by
// writeSalaryChange (lib/effectiveDating.ts), which a salary revision calls, and read only through salaryOn / salariesOn / salarySegments.
// The row's values and its frozen monthly breakup (employee_salary_lines) are immutable: an UPDATE may only set effective_to, and a row may be
// deleted only while it is still in the future. Money is exact decimals; user columns are plain text so nothing about a user can alter these rows.
enum SalaryChangeReason {
  JOINING
  REVISION
  CORRECTION
}

enum AdjustmentSource {
  MANUAL
  HOLD_RELEASE
  LOP_REVERSAL
  SALARY_ARREARS
  IMPORT
  YEAR_END_ENCASHMENT
}

enum AdjustmentStatus {
  PENDING
  CONSUMED
  CANCELLED
}

// A revision either writes new salary rows (CHANGE) or removes one salary row that has been written but not started (CANCEL_SCHEDULED). Both go
// through the same checker: cancelling a raise is a pay change like any other.
enum SalaryRevisionKind {
  CHANGE
  CANCEL_SCHEDULED
}

enum AdjustmentDirection {
  EARNING
  DEDUCTION
}

model EmployeeSalary {
  id               String                 @id @default(cuid())
  employeeId       String                 @map("employee_id")
  employee         Employee               @relation(fields: [employeeId], references: [id])
  effectiveFrom    DateTime               @map("effective_from") @db.Date
  effectiveTo      DateTime?              @map("effective_to") @db.Date
  reason           SalaryChangeReason
  annualCtc        Decimal                @map("annual_ctc") @db.Decimal(18, 2)
  monthlyCtc       Decimal                @map("monthly_ctc") @db.Decimal(20, 6)
  structureKey     String                 @map("structure_key")
  structureVersion Int                    @map("structure_version")
  structureHash    String                 @map("structure_hash")
  roundingPin      Json                   @map("rounding_pin") // { key, version, valueHash } of the rule the breakup was rounded by
  revisionId       String?                @map("revision_id")
  revision         PayrollSalaryRevision? @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  note             String                 @default("")
  createdByUserId  String                 @map("created_by_user_id")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  lines            EmployeeSalaryLine[]

  @@index([employeeId, effectiveTo])
  @@index([revisionId])
  @@map("employee_salaries")
}

model EmployeeSalaryLine {
  id               String         @id @default(cuid())
  salaryId         String         @map("salary_id")
  salary           EmployeeSalary @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  componentCode    String         @map("component_code")
  componentVersion Int            @map("component_version")
  componentType    String         @map("component_type") // EARNING | DEDUCTION | EMPLOYER_CONTRIBUTION, copied so totals are plain SQL
  amount           Decimal        @db.Decimal(20, 6)
  sortOrder        Int            @map("sort_order")

  @@unique([salaryId, componentCode])
  @@map("employee_salary_lines")
}

// A salary change as a unit: who it covers (resolved to a list at creation and frozen), what changes, from when. Its figures are recomputed from
// these inputs every time they are shown, approved or applied, so a checker approves exactly what would be written (the SALARY_REVISION subject).
model PayrollSalaryRevision {
  id              String             @id @default(cuid())
  kind            SalaryRevisionKind @default(CHANGE)
  effectiveFrom   DateTime           @map("effective_from") @db.Date
  reason          SalaryChangeReason
  note            String             @default("")
  selection       Json // how the people were picked, for display
  employeeIds     Json               @map("employee_ids") // string[] frozen at creation
  change          Json // { ctc?, structure?, perPerson? }
  createdByUserId String             @map("created_by_user_id")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  appliedAt       DateTime?          @map("applied_at") @db.Timestamptz(3)
  appliedByUserId String?            @map("applied_by_user_id")
  withdrawnAt     DateTime?          @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnReason String?            @map("withdrawn_reason")
  salaries        EmployeeSalary[]

  @@index([createdAt])
  @@map("payroll_salary_revisions")
}

// A one-off earning or deduction HR adds before a run, or arrears a back-dated revision created. The same (source, source_ref) can exist once, so the
// same arrears or encashment can never be added twice. A run consumes it; amounts and reasons never change after creation.
model PayrollAdjustment {
  id                String              @id @default(cuid())
  employeeId        String              @map("employee_id")
  employee          Employee            @relation(fields: [employeeId], references: [id])
  componentCode     String              @map("component_code")
  direction         AdjustmentDirection
  amount            Decimal             @db.Decimal(20, 6) // always positive; direction says which way
  reason            String
  source            AdjustmentSource
  sourceRef         String?             @map("source_ref")
  periodStart       DateTime?           @map("period_start") @db.Date // the cycle arrears belong to; null for a plain adjustment
  periodEnd         DateTime?           @map("period_end") @db.Date
  breakdown         Json? // arrears: [{ component, amount (signed) }]
  status            AdjustmentStatus    @default(PENDING)
  consumedByRunId   String?             @map("consumed_by_run_id") // set when a run is finalised (P6-4); until then a run only reads it
  consumedByRun     PayrollRun?         @relation(fields: [consumedByRunId], references: [id], onDelete: Restrict)
  createdByUserId   String              @map("created_by_user_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt       DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId String?             @map("cancelled_by_user_id")
  cancelReason      String?             @map("cancel_reason")

  @@unique([source, sourceRef])
  @@index([employeeId, status])
  @@map("payroll_adjustments")
}

// ── Phase 6, P6-3 — payroll runs (docs/plans/PHASE_6.md §14D) ──

// NEW: made, never calculated. CALCULATING/CALCULATED/FAILED: the job's states. SUBMITTED: waiting for a checker; APPROVED: a checker approved these exact
// figures. VOID: a discarded draft, or a final run that was unlocked. FINALISED: a database trigger refuses any change into or out of it unless the
// transaction has set payroll.finalising (into it, and only from APPROVED with both approvals consumed) or payroll.unlocking (out of it, to VOID, and only
// while nothing has been released against it). Only run/finaliser.ts sets either.
enum PayrollRunStatus {
  NEW
  CALCULATING
  CALCULATED
  SUBMITTED
  APPROVED
  FAILED
  VOID
  FINALISED
}

enum PayrollItemStatus {
  PAYABLE
  HELD
  EXCLUDED
}

enum PayrollLineKind {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  ROUNDING
}

enum PayrollLineSource {
  COMPONENT
  ADJUSTMENT
  HOLD_RELEASE
  LOP_REVERSAL
  MONTHLY_INPUT
  ARREARS
  ENCASHMENT
  PF
  ESI
  PT
  LWF
  NET_ROUNDING
}

// One regular run per attendance cycle (a partial unique index excludes VOID). The run records what it read: pins (every rule, and the structure,
// components and rounding that each salary was frozen under), a fingerprint of the rule versions at the start, and a fingerprint of the inputs, so a
// resumed or repeated calculation can tell whether the world moved.
model PayrollRun {
  id                 String           @id @default(cuid())
  cycleStart         DateTime         @map("cycle_start") @db.Date
  cycleEnd           DateTime         @map("cycle_end") @db.Date
  cycleLabel         String           @map("cycle_label")
  status             PayrollRunStatus @default(NEW)
  calcVersion        Int              @default(0) @map("calc_version")
  leaseOwner         String?          @map("lease_owner")
  leaseExpiresAt     DateTime?        @map("lease_expires_at") @db.Timestamptz(3)
  progressDone       Int              @default(0) @map("progress_done")
  progressTotal      Int              @default(0) @map("progress_total")
  pins               Json             @default("[]")
  rulesFingerprint   String?          @map("rules_fingerprint")
  inputsFingerprint  String?          @map("inputs_fingerprint")
  runHash            String?          @map("run_hash")
  totalGross         Decimal          @default(0) @map("total_gross") @db.Decimal(20, 6)
  totalDeductions    Decimal          @default(0) @map("total_deductions") @db.Decimal(20, 6)
  totalNet           Decimal          @default(0) @map("total_net") @db.Decimal(20, 6)
  totalEmployerCost  Decimal          @default(0) @map("total_employer_cost") @db.Decimal(20, 6)
  peopleCount        Int              @default(0) @map("people_count")
  payableCount       Int              @default(0) @map("payable_count")
  heldCount          Int              @default(0) @map("held_count")
  excludedCount      Int              @default(0) @map("excluded_count")
  exceptionCount     Int              @default(0) @map("exception_count")
  calculatedAt       DateTime?        @map("calculated_at") @db.Timestamptz(3)
  calculatedByUserId String?          @map("calculated_by_user_id")
  failureReason      String?          @map("failure_reason")
  createdByUserId    String           @map("created_by_user_id")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt           DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidedByUserId     String?          @map("voided_by_user_id")
  voidReason         String?          @map("void_reason")
  finalisedAt        DateTime?        @map("finalised_at") @db.Timestamptz(3)
  finalisedByUserId  String?          @map("finalised_by_user_id")

  items       PayrollRunItem[]
  lines       PayrollRunLine[]
  adjustments PayrollAdjustment[]
  locks       PayrollPeriodLock[]
  releases    PayrollRunRelease[]
  payslips    Payslip[]
  bankBatch   BankTransferBatch?
  outputs     PayrollOutput[]

  @@index([cycleStart, status])
  @@map("payroll_runs")
}

// One person in a run. HELD people are calculated but not payable (the reason is stored); EXCLUDED people had no salary for days they were employed.
// `inputs` is the explanation: the days, the shares, the salary segments, the pins behind the figures; `notices` and `exceptions` are shown on the screen.
model PayrollRunItem {
  id                    String            @id @default(cuid())
  runId                 String            @map("run_id")
  run                   PayrollRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId            String            @map("employee_id")
  employee              Employee          @relation(fields: [employeeId], references: [id])
  calcVersion           Int               @map("calc_version")
  status                PayrollItemStatus
  holdReason            String?           @map("hold_reason")
  holdDetail            String?           @map("hold_detail")
  employedFrom          DateTime?         @map("employed_from") @db.Date
  employedTo            DateTime?         @map("employed_to") @db.Date
  basisDays             Decimal           @default(0) @map("basis_days") @db.Decimal(8, 2)
  lopDivisorDays        Decimal           @default(0) @map("lop_divisor_days") @db.Decimal(8, 2)
  lopDays               Decimal           @default(0) @map("lop_days") @db.Decimal(8, 2)
  paidDays              Decimal           @default(0) @map("paid_days") @db.Decimal(12, 6) // for display; money is never worked out from this column
  gross                 Decimal           @default(0) @db.Decimal(20, 6)
  deductions            Decimal           @default(0) @db.Decimal(20, 6)
  employerContributions Decimal           @default(0) @map("employer_contributions") @db.Decimal(20, 6)
  netBeforeRounding     Decimal           @default(0) @map("net_before_rounding") @db.Decimal(20, 6)
  roundingAdjustment    Decimal           @default(0) @map("rounding_adjustment") @db.Decimal(20, 6)
  netPay                Decimal           @default(0) @map("net_pay") @db.Decimal(20, 6)
  employmentType        EmploymentType    @map("employment_type")
  placement             Json              @default("{}")
  structureKey          String?           @map("structure_key")
  structureVersion      Int?              @map("structure_version")
  inputs                Json              @default("{}")
  notices               Json              @default("[]")
  exceptions            Json              @default("[]")
  itemHash              String            @map("item_hash")
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines   PayrollRunLine[]
  payslip Payslip?

  @@unique([runId, employeeId])
  @@index([runId, status])
  @@map("payroll_run_items")
}

// One line on a person's payslip. `amount` is a magnitude (the kind says which way); only NET_ROUNDING is signed. `sourceRef` names the adjustment,
// arrears row or year-end item the line came from, so finalising marks exactly those consumed.
model PayrollRunLine {
  id         String            @id @default(cuid())
  runId      String            @map("run_id")
  run        PayrollRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  runItemId  String            @map("run_item_id")
  runItem    PayrollRunItem    @relation(fields: [runItemId], references: [id], onDelete: Cascade)
  employeeId String            @map("employee_id")
  sortOrder  Int               @map("sort_order")
  code       String
  label      String
  kind       PayrollLineKind
  source     PayrollLineSource
  sourceRef  String?           @map("source_ref")
  amount     Decimal           @db.Decimal(20, 6)
  basis      Json              @default("{}")

  @@unique([runItemId, sortOrder])
  @@index([runId, code])
  @@index([source, sourceRef])
  @@map("payroll_run_lines")
}

// ── Phase 6, P6-4 — the payroll lock and what has been released (docs/plans/PHASE_6.md §14F) ──

enum PayrollLockAction {
  FINALISE
  UNLOCK
}

// One row each time a payroll cycle is finalised or unlocked, append-only. A cycle is locked while its latest row is FINALISE. The real payroll lock reads this.
model PayrollPeriodLock {
  id          String            @id @default(cuid())
  seq         Int               @unique @default(autoincrement())
  cycleStart  DateTime          @map("cycle_start") @db.Date
  cycleEnd    DateTime          @map("cycle_end") @db.Date
  cycleLabel  String            @map("cycle_label")
  action      PayrollLockAction
  runId       String            @map("run_id")
  run         PayrollRun        @relation(fields: [runId], references: [id], onDelete: Restrict)
  runHash     String?           @map("run_hash")
  reason      String?
  actorUserId String            @map("actor_user_id")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([cycleStart, cycleEnd, seq])
  @@map("payroll_period_locks")
}

enum PayrollReleaseKind {
  PAYSLIPS_PUBLISHED
  BANK_FILE_GENERATED
}

// Written (P6-5) in the same transaction as publishing payslips or generating a bank file. While one exists for a run, the run's period cannot be unlocked.
model PayrollRunRelease {
  id          String             @id @default(cuid())
  runId       String             @map("run_id")
  run         PayrollRun         @relation(fields: [runId], references: [id], onDelete: Restrict)
  kind        PayrollReleaseKind
  reference   String?
  actorUserId String             @map("actor_user_id")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([runId, kind])
  @@map("payroll_run_releases")
}

// ── Phase 6, P6-5 — payslips, the bank file and the statutory outputs (docs/plans/PHASE_6.md §14H) ──

// One payslip per payable person of a final run, written in the transaction that publishes them. The content is immutable and complete (see run/payslip.ts); the table is
// append-only. What changes afterwards (the PDF, the notices) is in payslip_deliveries.
model Payslip {
  id                String         @id @default(cuid())
  runId             String         @map("run_id")
  run               PayrollRun     @relation(fields: [runId], references: [id], onDelete: Restrict)
  runItemId         String         @unique @map("run_item_id")
  runItem           PayrollRunItem @relation(fields: [runItemId], references: [id], onDelete: Restrict)
  employeeId        String         @map("employee_id")
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cycleLabel        String         @map("cycle_label")
  cycleStart        DateTime       @map("cycle_start") @db.Date
  cycleEnd          DateTime       @map("cycle_end") @db.Date
  content           Json
  contentHash       String         @map("content_hash")
  publishedAt       DateTime       @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedByUserId String         @map("published_by_user_id")

  delivery PayslipDelivery?

  @@unique([runId, employeeId])
  @@index([employeeId, cycleStart])
  @@map("payslips")
}

// Bookkeeping about getting a payslip to its owner, mutable by design and never content: the rendered PDF, the in-app notice and the email.
model PayslipDelivery {
  id               String    @id @default(cuid())
  payslipId        String    @unique @map("payslip_id")
  payslip          Payslip   @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  fileKey          String?   @map("file_key")
  fileSha256       String?   @map("file_sha256")
  renderedAt       DateTime? @map("rendered_at") @db.Timestamptz(3)
  renderError      String?   @map("render_error")
  notifiedAt       DateTime? @map("notified_at") @db.Timestamptz(3)
  emailStatus      String?   @map("email_status") // SENT | FILE_ONLY | FAILED, the same words as invitations
  emailTo          String?   @map("email_to")
  emailError       String?   @map("email_error")
  emailAttemptedAt DateTime? @map("email_attempted_at") @db.Timestamptz(3)
  attempts         Int       @default(0)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payslip_deliveries")
}

enum BankBatchStatus {
  GENERATED
  PAID
}

// The bank file made from a final run: one per run. The app never talks to a bank; PAID is HR's own statement, with the bank's reference. The batch can only move
// GENERATED to PAID and attach the bank's response; everything else about it is fixed by a trigger.
model BankTransferBatch {
  id                       String          @id @default(cuid())
  runId                    String          @unique @map("run_id")
  run                      PayrollRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  runHash                  String          @map("run_hash")
  status                   BankBatchStatus @default(GENERATED)
  paymentDate              DateTime        @map("payment_date") @db.Date
  templateVersion          Int             @map("template_version")
  templateHash             String          @map("template_hash")
  rowCount                 Int             @map("row_count")
  total                    Decimal         @db.Decimal(20, 6)
  excluded                 Json            @default("[]") // people payable but not in the file, with the reason
  fileKey                  String          @map("file_key")
  fileName                 String          @map("file_name")
  fileSha256               String          @map("file_sha256")
  generatedByUserId        String          @map("generated_by_user_id")
  generatedAt              DateTime        @default(now()) @map("generated_at") @db.Timestamptz(3)
  paidAt                   DateTime?       @map("paid_at") @db.Timestamptz(3)
  paidOn                   DateTime?       @map("paid_on") @db.Date
  paidByUserId             String?         @map("paid_by_user_id")
  bankReference            String?         @map("bank_reference")
  responseKey              String?         @map("response_key")
  responseFileName         String?         @map("response_file_name")
  responseSha256           String?         @map("response_sha256")
  responseAttachedByUserId String?         @map("response_attached_by_user_id")
  responseAttachedAt       DateTime?       @map("response_attached_at") @db.Timestamptz(3)

  rows BankTransferRow[]
  rejections      BankRowRejection[]
  returnImports   BankReturnImport[]
  repaymentPlans  BankRepaymentPlan[]
  repaymentBatches BankRepaymentBatch[]

  @@map("bank_transfer_batches")
}

// A row of the bank file. No account number is stored: only its blind-index hash, its last four digits and the IFSC; the number is decrypted once, inside generation.
model BankTransferRow {
  id            String            @id @default(cuid())
  batchId       String            @map("batch_id")
  batch         BankTransferBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  employeeId    String            @map("employee_id")
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  bankAccountId String            @map("bank_account_id")
  accountHash   String            @map("account_hash")
  accountLast4  String            @map("account_last4")
  ifsc          String
  amount        Decimal           @db.Decimal(20, 6)
  narration     String
  serial        Int

  rejection BankRowRejection?
  repayment BankRepaymentRow?

  @@unique([batchId, employeeId])
  @@map("bank_transfer_rows")
}

enum PayrollOutputKind {
  PF_ECR
  ESI
  PT
  LWF
  SALARY_REGISTER
}

// A generated statutory file or the register: who made it, from which final run and which confirmed layout, and the file's hash. Append-only.
model PayrollOutput {
  id                String            @id @default(cuid())
  runId             String            @map("run_id")
  run               PayrollRun        @relation(fields: [runId], references: [id], onDelete: Restrict)
  kind              PayrollOutputKind
  runHash           String            @map("run_hash")
  templateVersion   Int?              @map("template_version")
  templateHash      String?           @map("template_hash")
  rowCount          Int               @map("row_count")
  fileKey           String            @map("file_key")
  fileName          String            @map("file_name")
  fileSha256        String            @map("file_sha256")
  generatedByUserId String            @map("generated_by_user_id")
  generatedAt       DateTime          @default(now()) @map("generated_at") @db.Timestamptz(3)

  @@index([runId, kind])
  @@map("payroll_outputs")
}

// P6-6: a person's statement that they checked a whole class of people's data before the first real payroll run (docs/plans/PHASE_6.md §14J). The set that was checked is fixed by
// contentHash (keyed), so a change to any covered row afterwards makes it stale. Append-only.
enum PayrollSetupArea {
  SALARIES
  BANK_ACCOUNTS
  STATUTORY_IDS
}

model PayrollSetupSignoff {
  id             String            @id @default(cuid())
  area           PayrollSetupArea
  contentHash    String            @map("content_hash")
  covered        Int
  total          Int
  note           String
  authorUserIds  Json              @default("[]") @map("author_user_ids")
  /// D2: DIRECTOR_AUTHORITY when the signer was allowed to sign what they entered themselves (the other director was told); SECOND_DIRECTOR otherwise.
  authority      ApprovalAuthority @default(SECOND_DIRECTOR)
  signedByUserId String            @map("signed_by_user_id")
  signedAt       DateTime          @default(now()) @map("signed_at") @db.Timestamptz(3)

  @@index([area, signedAt])
  @@map("payroll_setup_signoffs")
}

// ── Director authority (D1, docs/plans/DIRECTOR_AUTHORITY.md) ────────────

enum ApprovalAuthority {
  SECOND_DIRECTOR
  DIRECTOR_AUTHORITY
}

// What a director did on their own authority, written in the same transaction as the act (so an act without a notice cannot exist). Counts only: no amounts, no
// names, no identifiers (the notice leaves the system by e-mail). No foreign keys, so a notice outlives the people it mentions. Append-only (database trigger).
model DirectorActionNotice {
  id           String             @id @default(cuid())
  kind         String // ACTION | SWITCH_CHANGED | SETTING_CHANGED
  step         String
  subjectType  String             @map("subject_type")
  subjectId    String             @map("subject_id")
  subjectLabel String             @map("subject_label")
  itemCount    Int?               @map("item_count")
  actorUserId  String             @map("actor_user_id")
  approvalId   String?            @map("approval_id")
  authority    ApprovalAuthority?
  detail       Json               @default("{}")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  receipts DirectorActionReceipt[]

  @@index([createdAt])
  @@map("director_action_notices")
}

// One row per other director. Delivery, seen, acknowledgement and escalation are each filled in once (database trigger); nothing else ever changes.
model DirectorActionReceipt {
  id              String               @id @default(cuid())
  noticeId        String               @map("notice_id")
  notice          DirectorActionNotice @relation(fields: [noticeId], references: [id])
  recipientUserId String               @map("recipient_user_id")
  deliveredAt     DateTime?            @map("delivered_at") @db.Timestamptz(3)
  emailedAt       DateTime?            @map("emailed_at") @db.Timestamptz(3)
  failedReason    String?              @map("failed_reason")
  seenAt          DateTime?            @map("seen_at") @db.Timestamptz(3)
  acknowledgedAt  DateTime?            @map("acknowledged_at") @db.Timestamptz(3)
  escalatedAt     DateTime?            @map("escalated_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([noticeId, recipientUserId])
  @@index([recipientUserId, acknowledgedAt])
  @@map("director_action_receipts")
}

// Stage 1 (docs/plans/HR_CAPABILITIES.md §1A): every role_permissions row the HR hard-lock migration removed, copied here first. Append-only (database trigger), so the removal
// can be put back by a forward migration and nobody can rewrite what it was.
model RolePermissionRemoval {
  id            String   @id @default(cuid())
  roleCode      String   @map("role_code")
  permissionKey String   @map("permission_key")
  reason        String
  removedAt     DateTime @default(now()) @map("removed_at") @db.Timestamptz(3)

  @@index([roleCode])
  @@map("role_permission_removals")
}

// Stage 1 (docs/plans/HR_CAPABILITIES.md §1B): what a director has switched on or off for HR. Append-only: a change is a new row, the state at any moment is the latest row in force
// per capability and subject, and the whole history is shown on the screen. subject_key is a role code (ROLE) or a user id (USER), plain text with no foreign key, like the other
// append-only records.
model HrCapabilitySwitch {
  id              String   @id @default(cuid())
  capability      String
  subjectKind     String   @map("subject_kind") // ROLE | USER
  subjectKey      String   @map("subject_key")
  state           String // ON | OFF | DEFAULT
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(3)
  reason          String
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([capability, subjectKind, subjectKey, effectiveFrom])
  @@index([subjectKind, subjectKey])
  @@map("hr_capability_switches")
}

// ── Stage 3.3c — a director's hold on one person's salary for one month, and its release (docs/plans/PAYROLL_MODEL_PLAN.md) ──
// Append-only, written only by a Super Admin (a database trigger holds that whatever the code does). A hold with no release is "held". employee_id and the actor
// columns are plain text: nothing that happens to an employee or a user can alter these records.
model PayrollSalaryHold {
  id           String   @id @default(cuid())
  employeeId   String   @map("employee_id")
  cycleStart   DateTime @map("cycle_start") @db.Date
  reason       String
  heldByUserId String   @map("held_by_user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  release PayrollSalaryRelease?

  @@unique([employeeId, cycleStart])
  @@map("payroll_salary_holds")
}

model PayrollSalaryRelease {
  id               String            @id @default(cuid())
  holdId           String            @unique @map("hold_id")
  hold             PayrollSalaryHold @relation(fields: [holdId], references: [id])
  note             String
  releasedByUserId String            @map("released_by_user_id")
  /**
   * The pending adjustment that pays the held amount, when the held month's run was already final; null when the hold was lifted before the run was final.
   */
  adjustmentId     String?           @map("adjustment_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("payroll_salary_releases")
}

// ── Stage 4 — Monthly Inputs (docs/plans/STAGE_4_PLAN.md) ──
// One row per entry of one figure: a pay head flagged "takes its value from Monthly Inputs", for one person, for one payroll month. Append-only; the current figure of
// a cell is its newest row. `cleared` returns the cell to blank (nothing entered), which is not the same as zero. Only a Super Admin writes (a trigger holds that
// whatever the code does). employee_id and the actor are plain text: nothing that happens to an employee or a user can alter this history.
model PayrollMonthlyInput {
  id              String   @id @default(cuid())
  employeeId      String   @map("employee_id")
  componentCode   String   @map("component_code")
  cycleStart      DateTime @map("cycle_start") @db.Date
  amount          Decimal? @db.Decimal(20, 6) // exact; always zero or more; the head says earning or deduction. Null when cleared.
  cleared         Boolean  @default(false)
  reason          String
  enteredByUserId String   @map("entered_by_user_id")
  batchId         String?  @map("batch_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([cycleStart, componentCode])
  @@index([employeeId, cycleStart, componentCode, createdAt])
  @@map("payroll_monthly_inputs")
}

enum MonthlyInputBatchStatus {
  PREVIEW
  APPLIED
  DISCARDED
}

// An uploaded file after it has been read and checked, kept so a director can look at the preview and confirm it. Nothing in it is a figure of a month until it is
// APPLIED. The same file (by hash) can be APPLIED once (a partial unique index). A batch is only ever changed while it is a PREVIEW.
model PayrollInputBatch {
  id               String                  @id @default(cuid())
  fileName         String                  @map("file_name")
  fileHash         String                  @map("file_hash")
  status           MonthlyInputBatchStatus @default(PREVIEW)
  parsed           Json // the rows as read: line number, employee number, months, figures as text, problems
  summary          Json
  skipInvalid      Boolean                 @default(false) @map("skip_invalid")
  uploadedByUserId String                  @map("uploaded_by_user_id")
  appliedByUserId  String?                 @map("applied_by_user_id")
  appliedAt        DateTime?               @map("applied_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([fileHash])
  @@map("payroll_input_batches")
}

// ── Stage 5a — remote attendance (docs/plans/STAGE_5A_PLAN.md) ──
// A director marks who works remotely, from a date. Nobody is remote by default. Marks are append-only (the latest mark effective on a day decides) and only a Super Admin
// writes one (a trigger holds that). The employee's day is one record: a check-in and a check-out, each a time stamped by the server (no location, no address, no device).
enum RemoteRecordStatus {
  OPEN
  PENDING
  APPROVED_FULL
  APPROVED_HALF
  REJECTED
}

enum RemoteHalf {
  FIRST
  SECOND
}

enum RemoteRejectOutcome {
  ABSENT
  LOSS_OF_PAY
}

enum RemoteRequestKind {
  CORRECTION
  REVIEW
}

enum RemoteRequestStatus {
  OPEN
  ACCEPTED
  DECLINED
}

model RemoteWorkMark {
  id             String   @id @default(cuid())
  employeeId     String   @map("employee_id")
  effectiveFrom  DateTime @map("effective_from") @db.Date
  remote         Boolean
  reason         String
  markedByUserId String   @map("marked_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([employeeId, effectiveFrom, createdAt])
  @@map("remote_work_marks")
}

model RemoteAttendanceRecord {
  id              String                    @id @default(cuid())
  employeeId      String                    @map("employee_id")
  employee        Employee                  @relation(fields: [employeeId], references: [id])
  date            DateTime                  @db.Date
  checkInAt       DateTime?                 @map("check_in_at") @db.Timestamptz(3)
  checkOutAt      DateTime?                 @map("check_out_at") @db.Timestamptz(3)
  status          RemoteRecordStatus        @default(OPEN)
  half            RemoteHalf?
  rejectOutcome   RemoteRejectOutcome?      @map("reject_outcome")
  decisionReason  String?                   @map("decision_reason")
  decidedByUserId String?                   @map("decided_by_user_id")
  decidedAt       DateTime?                 @map("decided_at") @db.Timestamptz(3)
  overrideId      String?                   @map("override_id")
  reopenCount     Int                       @default(0) @map("reopen_count")
  reminderSentAt  DateTime?                 @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  events          RemoteAttendanceEvent[]
  requests        RemoteAttendanceRequest[]

  @@unique([employeeId, date])
  @@index([status, date])
  @@map("remote_attendance_records")
}

// What happened to a record, in order. Append-only.
model RemoteAttendanceEvent {
  id          String                 @id @default(cuid())
  recordId    String                 @map("record_id")
  record      RemoteAttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type        String
  actorUserId String?                @map("actor_user_id")
  note        String                 @default("")
  payload     Json                   @default("{}")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([recordId, createdAt])
  @@map("remote_attendance_events")
}

model RemoteAttendanceRequest {
  id                String                 @id @default(cuid())
  recordId          String                 @map("record_id")
  record            RemoteAttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  kind              RemoteRequestKind
  status            RemoteRequestStatus    @default(OPEN)
  note              String
  proposedCheckIn   DateTime?              @map("proposed_check_in") @db.Timestamptz(3)
  proposedCheckOut  DateTime?              @map("proposed_check_out") @db.Timestamptz(3)
  requestedByUserId String                 @map("requested_by_user_id")
  resolvedByUserId  String?                @map("resolved_by_user_id")
  resolvedAt        DateTime?              @map("resolved_at") @db.Timestamptz(3)
  resolutionNote    String?                @map("resolution_note")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([recordId, status])
  @@map("remote_attendance_requests")
}

// ── Stage 5b — rows the bank rejected, and paying them again (docs/plans/STAGE_5B_PLAN.md) ──
model BankReturnImport {
  id               String              @id @default(cuid())
  batchId          String              @map("batch_id")
  batch            BankTransferBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  fileSha256       String              @map("file_sha256")
  fileName         String              @map("file_name")
  rejectedCount    Int                 @map("rejected_count")
  importedByUserId String              @map("imported_by_user_id")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  rejections       BankRowRejection[]

  @@unique([batchId, fileSha256])
  @@map("bank_return_imports")
}

model BankRowRejection {
  id               String            @id @default(cuid())
  batchId          String            @map("batch_id")
  batch            BankTransferBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  rowId            String            @unique @map("row_id")
  row              BankTransferRow   @relation(fields: [rowId], references: [id], onDelete: Restrict)
  reason           String
  source           String
  importId         String?           @map("import_id")
  import           BankReturnImport? @relation(fields: [importId], references: [id], onDelete: Restrict)
  recordedByUserId String            @map("recorded_by_user_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([batchId])
  @@map("bank_row_rejections")
}

model BankRepaymentPlan {
  id              String                @id @default(cuid())
  originalBatchId String                @map("original_batch_id")
  originalBatch   BankTransferBatch     @relation(fields: [originalBatchId], references: [id], onDelete: Restrict)
  paymentDate     DateTime              @map("payment_date") @db.Date
  rowIds          Json                  @map("row_ids")
  createdByUserId String                @map("created_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  batch           BankRepaymentBatch?

  @@map("bank_repayment_plans")
}

model BankRepaymentBatch {
  id                String                @id @default(cuid())
  planId            String                @unique @map("plan_id")
  plan              BankRepaymentPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  originalBatchId   String                @map("original_batch_id")
  originalBatch     BankTransferBatch     @relation(fields: [originalBatchId], references: [id], onDelete: Restrict)
  paymentDate       DateTime              @map("payment_date") @db.Date
  templateVersion   Int                   @map("template_version")
  templateHash      String                @map("template_hash")
  rowCount          Int                   @map("row_count")
  total             Decimal               @db.Decimal(20, 6)
  fileKey           String                @map("file_key")
  fileName          String                @map("file_name")
  fileSha256        String                @map("file_sha256")
  generatedByUserId String                @map("generated_by_user_id")
  generatedAt       DateTime              @default(now()) @map("generated_at") @db.Timestamptz(3)
  rows              BankRepaymentRow[]

  @@map("bank_repayment_batches")
}

model BankRepaymentRow {
  id            String             @id @default(cuid())
  batchId       String             @map("batch_id")
  batch         BankRepaymentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sourceRowId   String             @unique @map("source_row_id")
  sourceRow     BankTransferRow    @relation(fields: [sourceRowId], references: [id], onDelete: Restrict)
  employeeId    String             @map("employee_id")
  employee      Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  bankAccountId String             @map("bank_account_id")
  accountHash   String             @map("account_hash")
  accountLast4  String             @map("account_last4")
  ifsc          String
  amount        Decimal            @db.Decimal(20, 6)
  narration     String
  serial        Int

  @@unique([batchId, serial])
  @@map("bank_repayment_rows")
}
